<?xml version="1.0" encoding="utf-8"?>
<!--
    Per-user isolation for Moneta.

    Every owned model gets two record rules:
      * group_moneta_user    -> [('user_id','=',user.id)]   (own data only)
      * group_moneta_manager -> [(1,'=',1)]                 (all data)

    group_moneta_manager implies group_moneta_user, so a manager matches both
    rules and the OR yields everything. A user in neither group has no
    ir.model.access grant at all and can never reach these rules.

    Child models (split / alias / price / holding) carry a stored `user_id`
    related from their parent so the same domain resolves to the owner.
-->
<odoo>
    <data>

        <!-- moneta.account -->
        <record id="moneta_account_rule_user" model="ir.rule">
            <field name="name">Moneta Account: own or shared</field>
            <field name="model_id" ref="model_moneta_account"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('shared_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_moneta_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <record id="moneta_account_rule_manager" model="ir.rule">
            <field name="name">Moneta Account: manager</field>
            <field name="model_id" ref="model_moneta_account"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_moneta_manager'))]"/>
        </record>

        <!-- moneta.account.share -->
        <record id="moneta_account_share_rule_user" model="ir.rule">
            <field name="name">Moneta Account Share: owner or grantee</field>
            <field name="model_id" ref="model_moneta_account_share"/>
            <field name="domain_force">['|', ('owner_id', '=', user.id), ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_moneta_user'))]"/>
        </record>
        <record id="moneta_account_share_rule_manager" model="ir.rule">
