<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quicken Premier & Modern Wealth Command Center -->
    <record id="view_moneta_dashboard_form" model="ir.ui.view">
        <field name="name">moneta.dashboard.form</field>
        <field name="model">moneta.dashboard</field>
        <field name="arch" type="xml">
            <form string="Personal Finance Command Center" class="o_moneta_dashboard">
                <sheet>
                    <!-- Consolidated Command & Advisory Banner with Currency Selector -->
                    <div class="card moneta-card p-3 mb-4 shadow-xs" style="background: linear-gradient(135deg, #f0f9ff 0%, #ffffff 100%) !important; border-left: 5px solid #0284c7 !important; border: 1px solid rgba(186, 230, 253, 0.6) !important; border-radius: 12px;">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                            <!-- Left: Advisory Icon & Title & Description -->
                            <div class="d-flex align-items-center gap-3" style="flex: 1; min-width: 320px;">
                                <div class="rounded-circle bg-white p-2 shadow-xs text-primary d-flex align-items-center justify-content-center border border-info border-opacity-25" style="width: 48px; height: 48px; min-width: 48px;">
                                    <i class="fa fa-lightbulb-o fa-2x" style="color: #0284c7;"/>
                                </div>
                                <div>
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="badge rounded-pill px-3 py-1 text-white fw-bold" style="background-color: #0284c7 !important; font-size: 0.72rem;">
                                            <i class="fa fa-circle text-success me-1" style="font-size: 0.55rem;"/>Live Advisory
                                        </span>
                                        <h5 class="fw-bold mb-0 text-dark" style="font-size: 1.05rem;"><field name="top_insight_title"/></h5>
                                        <span class="badge bg-white text-primary border border-info border-opacity-25 fw-semibold" style="color: #0284c7 !important;"><field name="top_insight_badge"/></span>
                                    </div>
                                    <p class="text-muted small mb-0 mt-1"><field name="top_insight_desc"/></p>
                                </div>
                            </div>

                            <!-- Right: Currency Selector & Quick Action Buttons -->
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <div class="d-flex align-items-center bg-white px-3 py-1 rounded-pill border shadow-xs" style="gap: 0.5rem;">
                                    <span class="small fw-bold text-muted text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Currency:</span>
                                    <field name="currency_id" options="{'no_create': True, 'no_open': True}" class="fw-bold" style="font-size: 0.85rem; border: none; min-width: 100px;"/>
                                </div>
                                <button name="action_open_holdings" type="object" class="btn btn-outline-primary rounded-pill px-3 fw-semibold shadow-xs" style="font-size: 0.85rem; border-color: #0284c7 !important; color: #0284c7 !important; background: #ffffff !important;">
                                    <i class="fa fa-line-chart me-1"/>Portfolio
                                </button>
                                <button name="action_open_insights" type="object" class="btn btn-primary rounded-pill px-3 shadow-sm fw-semibold" style="font-size: 0.85rem; background-color: #0284c7 !important; border-color: #0284c7 !important;">
                                    <i class="fa fa-arrow-circle-right me-1"/>Insights (<field name="insight_count"/>)
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Row 1: Primary Wealth & Cash Flow KPIs -->
                    <div class="row g-3 mb-4">
                        <!-- Net Worth Card -->
                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="moneta-kpi-card moneta-kpi-card-networth h-100">
                                <div class="moneta-kpi-header">
                                    <span class="moneta-kpi-title">Net Worth</span>
                                    <span class="moneta-kpi-icon-wrapper bg-success-light text-success">
                                        <i class="fa fa-shield"/>
                                    </span>
                                </div>
                                <div class="moneta-kpi-value text-success">
                                    <field name="net_worth" widget="monetary"/>
                                </div>
                                <div class="moneta-kpi-footer">
                                    <span>Assets: <strong class="text-dark"><field name="total_assets" widget="monetary"/></strong></span>
                                    <span>Debt: <strong class="text-danger"><field name="total_liabilities" widget="monetary"/></strong></span>
                                </div>
                            </div>
                        </div>

                        <!-- Cash Flow Card -->
                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="moneta-kpi-card moneta-kpi-card-cashflow h-100">
                                <div class="moneta-kpi-header">
                                    <span class="moneta-kpi-title">Cash Flow (<field name="month_label"/>)</span>
                                    <span class="badge bg-success" invisible="savings_rate &lt;= 0">
                                        <field name="savings_rate"/>% Saved
                                    </span>
                                    <span class="moneta-kpi-icon-wrapper bg-info-light text-primary" invisible="savings_rate &gt; 0">
                                        <i class="fa fa-exchange"/>
                                    </span>
                                </div>
                                <div class="moneta-kpi-value text-primary">
                                    <field name="month_net_savings" widget="monetary"/>
                                </div>
                                <div class="moneta-kpi-footer">
                                    <span class="text-success fw-semibold" title="Monthly Inflow"><i class="fa fa-arrow-up me-1"/><field name="month_income" widget="monetary"/></span>
                                    <span class="text-danger fw-semibold" title="Monthly Outflow"><i class="fa fa-arrow-down me-1"/><field name="month_expenses" widget="monetary"/></span>
                                </div>
                            </div>
                        </div>

                        <!-- Portfolio Card -->
                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="moneta-kpi-card moneta-kpi-card-investments h-100">
                                <div class="moneta-kpi-header">
                                    <span class="moneta-kpi-title">Stocks &amp; Portfolio</span>
                                    <span class="moneta-kpi-icon-wrapper bg-warning-light text-warning">
                                        <i class="fa fa-line-chart"/>
                                    </span>
                                </div>
                                <div class="moneta-kpi-value text-dark">
                                    <field name="portfolio_market_value" widget="monetary"/>
                                </div>
                                <div class="moneta-kpi-footer">
                                    <span>Gain: <strong class="text-success" invisible="portfolio_unrealized_gain &lt; 0">+<field name="portfolio_unrealized_gain" widget="monetary"/></strong><strong class="text-danger" invisible="portfolio_unrealized_gain &gt;= 0"><field name="portfolio_unrealized_gain" widget="monetary"/></strong></span>
                                    <span class="badge bg-success" invisible="portfolio_gain_percent &lt; 0">+<field name="portfolio_gain_percent"/>%</span>
                                    <span class="badge bg-danger" invisible="portfolio_gain_percent &gt;= 0"><field name="portfolio_gain_percent"/>%</span>
                                </div>
                            </div>
                        </div>

                        <!-- Real Estate Equity Card -->
                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="moneta-kpi-card moneta-kpi-card-realestate h-100">
                                <div class="moneta-kpi-header">
                                    <span class="moneta-kpi-title">Real Estate Equity</span>
                                    <span class="moneta-kpi-icon-wrapper bg-purple-light text-purple">
                                        <i class="fa fa-home"/>
                                    </span>
                                </div>
                                <div class="moneta-kpi-value text-dark">
                                    <field name="total_real_estate_equity" widget="monetary"/>
                                </div>
                                <div class="moneta-kpi-footer">
                                    <span>Valuation: <strong class="text-dark"><field name="real_estate_assets" widget="monetary"/></strong></span>
                                    <span class="badge bg-primary-light text-primary fw-semibold">Active Equity</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: Wealthfolio Balance Sheet Breakdown -->
                    <div class="row g-3 mb-4">
                        <!-- Assets Breakdown -->
                        <div class="col-12 col-md-6">
                            <div class="card moneta-card h-100 p-4">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0">
                                            <i class="fa fa-pie-chart text-success me-2"/>Asset Allocation Breakdown
                                        </h6>
                                        <span class="text-muted small">Liquid cash, investment portfolios, and real estate equity</span>
                                    </div>
                                    <span class="badge rounded-pill bg-success-subtle-glow px-3 py-1 fw-bold fs-6">
                                        Total: <field name="total_assets" widget="monetary"/>
                                    </span>
                                </div>

                                <div class="d-flex flex-column gap-1">
                                    <button name="action_open_accounts" type="object" class="moneta-breakdown-row w-100 text-start d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="moneta-indicator-dot" style="background-color: #2ecc71;"/>
                                            <span class="fw-semibold text-dark">🏦 Cash &amp; Bank Accounts</span>
                                        </div>
                                        <span class="fw-bold text-dark"><field name="cash_assets" widget="monetary"/> <i class="fa fa-angle-right ms-1 text-muted"/></span>
                                    </button>

                                    <button name="action_open_holdings" type="object" class="moneta-breakdown-row w-100 text-start d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="moneta-indicator-dot" style="background-color: #3498db;"/>
                                            <span class="fw-semibold text-dark">📈 Stocks &amp; Brokerage</span>
                                        </div>
                                        <span class="fw-bold text-primary"><field name="investment_assets" widget="monetary"/> <i class="fa fa-angle-right ms-1 text-muted"/></span>
                                    </button>

                                    <button name="action_open_properties" type="object" class="moneta-breakdown-row w-100 text-start d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="moneta-indicator-dot" style="background-color: #8b5cf6;"/>
                                            <span class="fw-semibold text-dark">🏡 Real Estate &amp; Properties</span>
                                        </div>
                                        <span class="fw-bold text-dark"><field name="real_estate_assets" widget="monetary"/> <i class="fa fa-angle-right ms-1 text-muted"/></span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Liabilities Breakdown -->
                        <div class="col-12 col-md-6">
                            <div class="card moneta-card h-100 p-4">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0">
                                            <i class="fa fa-credit-card text-danger me-2"/>Debt &amp; Liabilities Breakdown
                                        </h6>
                                        <span class="text-muted small">Credit cards, mortgages, term loans, and upcoming bills</span>
                                    </div>
                                    <span class="badge rounded-pill bg-danger-subtle-glow px-3 py-1 fw-bold fs-6">
                                        Total: <field name="total_liabilities" widget="monetary"/>
                                    </span>
                                </div>

                                <div class="d-flex flex-column gap-1">
                                    <button name="action_open_credit_cards" type="object" class="moneta-breakdown-row w-100 text-start d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="moneta-indicator-dot" style="background-color: #8e44ad;"/>
                                            <span class="fw-semibold text-dark">💳 Credit Card Balances</span>
                                        </div>
                                        <span class="fw-bold text-danger"><field name="credit_card_debt" widget="monetary"/> <i class="fa fa-angle-right ms-1 text-muted"/></span>
                                    </button>

                                    <button name="action_open_loans" type="object" class="moneta-breakdown-row w-100 text-start d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="moneta-indicator-dot" style="background-color: #e74c3c;"/>
                                            <span class="fw-semibold text-dark">🏛️ Mortgages &amp; Term Loans</span>
                                        </div>
                                        <span class="fw-bold text-danger"><field name="loans_mortgages_debt" widget="monetary"/> <i class="fa fa-angle-right ms-1 text-muted"/></span>
                                    </button>

                                    <button name="action_open_upcoming_bills" type="object" class="moneta-breakdown-row w-100 text-start d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="moneta-indicator-dot" style="background-color: #f59e0b;"/>
                                            <span class="fw-semibold text-dark">📅 Upcoming Bills (14 Days)</span>
                                        </div>
                                        <span class="fw-bold text-warning"><field name="upcoming_bills_total" widget="monetary"/> (<field name="upcoming_bill_count"/> due) <i class="fa fa-angle-right ms-1 text-muted"/></span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 3: Financial Freedom & Resilience (FIRE & Runway) -->
                    <div class="row g-3 mb-4">
                        <!-- Emergency Runway Card -->
                        <div class="col-12 col-md-6">
                            <div class="card moneta-card h-100 p-4">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-muted fw-bold small text-uppercase"><i class="fa fa-shield me-1 text-success"/>Financial Runway Buffer</span>
                                    <span class="badge bg-success rounded-pill px-3 py-1 fs-6"><field name="emergency_runway_months"/> Months</span>
                                </div>
                                <p class="text-muted small mb-0 mt-1">
                                    Calculated from your liquid cash and stocks vs. your 3-month average burn rate. You can sustain your current lifestyle for <strong class="text-dark"><field name="emergency_runway_months"/> months</strong> with zero active income.
                                </p>
                            </div>
                        </div>

                        <!-- FIRE Milestone Card -->
                        <div class="col-12 col-md-6">
                            <div class="card moneta-card h-100 p-4">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-muted fw-bold small text-uppercase"><i class="fa fa-fire me-1 text-danger"/>FIRE Goal (4% Safe Withdrawal Rule)</span>
                                    <span class="fw-bold text-primary fs-6"><field name="fire_progress_pct"/>% Achieved</span>
                                </div>
                                <div class="my-2">
                                    <field name="fire_progress_pct" widget="progressbar"/>
                                </div>
                                <div class="d-flex justify-content-between small text-muted">
                                    <span>Target: <strong class="text-dark"><field name="fire_target_amount" widget="monetary"/></strong></span>
                                    <span>(25× Annualized Expenses)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Dynamic Quick Action Launchpad -->
                    <div class="card moneta-card p-4 mb-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div>
                                <h6 class="fw-bold text-dark mb-0">
                                    <i class="fa fa-bolt me-1 text-warning"/>Quick Action Launchpad
                                </h6>
                                <span class="text-muted small">One-click instant workflows and quick entries</span>
                            </div>
                            <button name="action_customize_launchpad" type="object" class="btn btn-sm btn-outline-secondary rounded-pill px-3" string="⚙️ Customize" icon="fa-cog"/>
                        </div>
                        <field name="action_launchpad_ids" mode="kanban" class="border-0 p-0 m-0" nolabel="1">
                            <kanban class="moneta-launchpad-kanban border-0 p-0 m-0" create="false">
                                <field name="name"/>
                                <field name="icon"/>
                                <field name="color_class"/>
                                <field name="action_type"/>
                                <templates>
                                    <t t-name="card">
                                        <button name="action_execute" type="object" 
                                                t-attf-class="btn moneta-launchpad-btn #{record.color_class.raw_value == 'primary' ? 'btn-primary text-white' : (record.color_class.raw_value == 'outline_success' ? 'btn-outline-success' : (record.color_class.raw_value == 'outline_danger' ? 'btn-outline-danger' : (record.color_class.raw_value == 'outline_warning' ? 'btn-outline-warning' : (record.color_class.raw_value == 'outline_info' ? 'btn-outline-info' : (record.color_class.raw_value == 'outline_dark' ? 'btn-outline-dark' : (record.color_class.raw_value == 'outline_secondary' ? 'btn-outline-secondary' : 'btn-outline-primary'))))))}">
                                            <i t-attf-class="fa #{record.icon.raw_value or 'fa-bolt'} fa-fw"/>
                                            <span class="fw-medium"><field name="name"/></span>
                                        </button>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </div>

                    <!-- Hidden technical fields -->
                    <field name="currency_id" invisible="1"/>
                    <field name="user_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_moneta_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">moneta.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <!-- OWL 2.0 Client Action for Executive Wealth Dashboard (Alternative View) -->
    <record id="action_moneta_dashboard_client" model="ir.actions.client">
        <field name="name">Fintech Dashboard (Experimental)</field>
        <field name="tag">moneta_finance.dashboard_client_action</field>
        <field name="target">main</field>
    </record>
</odoo>
