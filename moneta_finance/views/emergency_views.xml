<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Emergency Access Contact Form View -->
    <record id="view_moneta_emergency_contact_form" model="ir.ui.view">
        <field name="name">moneta.emergency.contact.form</field>
        <field name="model">moneta.emergency.contact</field>
        <field name="arch" type="xml">
            <form string="Emergency Access &amp; Digital Estate Contact">
                <header>
                    <button name="action_initiate_claim" type="object" string="Initiate Emergency Claim" class="btn-warning" invisible="status != 'active'" confirm="Are you sure you want to trigger the emergency claim waiting period?"/>
                    <button name="action_decline_claim" type="object" string="🚫 Decline Claim" class="btn-danger" invisible="status != 'pending_claim'" confirm="Are you sure you want to decline this emergency claim?"/>
                    <button name="action_approve_access" type="object" string="Grant Access Early" class="btn-success" invisible="status != 'pending_claim'"/>
                    <button name="action_revoke_access" type="object" string="Revoke Contact" class="btn-secondary" invisible="status in ('revoked', 'declined')"/>
                    <field name="status" widget="statusbar" statusbar_visible="active,pending_claim,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Contact Name"/>
                        <h1><field name="name" placeholder="e.g. Jane Doe (Spouse)"/></h1>
                    </div>

                    <!-- Pending Claim Alert Banner -->
                    <div class="alert alert-warning d-flex align-items-center justify-content-between p-3 my-3 rounded-3" invisible="status != 'pending_claim'">
                        <div>
                            <i class="fa fa-clock-o fa-2x text-warning me-3"/>
                            <strong>Emergency Access Claim Pending!</strong>
                            <p class="mb-0 small text-muted">
                                Unlock Date: <strong><field name="unlock_date"/></strong> (<field name="days_remaining"/> days remaining). Owner will receive daily email alerts until grace period expires.
                            </p>
                        </div>
                    </div>

                    <group>
                        <group string="Contact Details">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="relationship"/>
                            <field name="user_id" invisible="1"/>
                        </group>
                        <group string="Security Waiting Period &amp; Unlock">
                            <field name="waiting_period_days"/>
                            <field name="claim_request_date" invisible="not claim_request_date"/>
                            <field name="unlock_date" invisible="not unlock_date"/>
                            <field name="days_remaining" invisible="status != 'pending_claim'"/>
                            <field name="access_granted_date" invisible="not access_granted_date"/>
                        </group>
                    </group>
                    <group string="Secure Instructions &amp; Vault Notes">
                        <field name="notes" placeholder="Add confidential guidance for this contact (e.g. location of physical documents, estate attorney contact info, safe deposit instructions)..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Emergency Access Contact List View -->
    <record id="view_moneta_emergency_contact_tree" model="ir.ui.view">
        <field name="name">moneta.emergency.contact.list</field>
        <field name="model">moneta.emergency.contact</field>
        <field name="arch" type="xml">
            <list string="Emergency Contacts">
                <field name="name"/>
                <field name="relationship"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="waiting_period_days" string="Grace Period (Days)"/>
                <field name="unlock_date" string="Unlock Date" optional="show"/>
                <field name="days_remaining" string="Days Left" optional="show"/>
                <field name="status" widget="badge" 
                       decoration-success="status == 'active'" 
                       decoration-warning="status == 'pending_claim'" 
                       decoration-info="status == 'approved'" 
                       decoration-muted="status == 'declined'" 
                       decoration-danger="status == 'revoked'"/>
            </list>
        </field>
    </record>

    <record id="action_moneta_emergency_contact" model="ir.actions.act_window">
        <field name="name">Emergency Contacts &amp; Digital Will</field>
        <field name="res_model">moneta.emergency.contact</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Designate a Trusted Emergency Contact
            </p>
            <p>
                Set up a secure emergency protocol with configurable waiting periods for family or estate executors.
            </p>
        </field>
    </record>
</odoo>
