<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Res Config Settings View for Moneta Finance Core -->
    <record id="view_moneta_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.moneta</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Moneta Finance" string="Moneta Finance" name="moneta_finance">
                    <block title="Currencies &amp; Exchange Rates" id="moneta_currency_block">
                        <setting id="moneta_main_currency" string="Main Base Currency" help="Primary reporting currency for accounts, net worth calculations, and financial reports.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="currency_id" string="Base Currency" class="col-lg-3 o_light_label"/>
                                    <field name="currency_id" options="{'no_create_edit': True, 'no_open': True}" class="col-lg-9"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="moneta_multi_currencies" string="Multi-Currencies" help="Enable foreign currency bank accounts, multi-currency transfers, and exchange rates.">
                            <field name="group_multi_currency"/>
                            <div class="content-group" invisible="not group_multi_currency">
                                <div class="mt8">
                                    <button name="%(base.action_currency_form)d" icon="fa-arrow-right" type="action" string="Manage Currencies &amp; Exchange Rates" class="btn-link"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_moneta_config_settings" model="ir.actions.act_window">
        <field name="name">Moneta Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'moneta_finance'}</field>
    </record>
</odoo>
