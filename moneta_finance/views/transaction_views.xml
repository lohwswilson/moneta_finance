<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Transaction Form View -->
    <record id="view_moneta_transaction_form" model="ir.ui.view">
        <field name="name">moneta.transaction.form</field>
        <field name="model">moneta.transaction</field>
        <field name="arch" type="xml">
            <form string="Transaction">
                <header>
                    <button name="action_toggle_cleared" type="object" string="Toggle Cleared / Reconciled" class="btn-secondary" invisible="state == 'void'"/>
                    <button name="action_mark_cleared" type="object" string="Mark Cleared"
                            class="btn-primary"
                            invisible="state in ('cleared', 'reconciled', 'void')"/>
                    <button name="action_reconcile" type="object" string="Reconcile"
                            invisible="state in ('reconciled', 'void')"/>
                    <button name="action_unreconcile" type="object" string="Unreconcile"
                            invisible="state in ('unreconciled', 'void')"/>
                    <field name="state" widget="statusbar" statusbar_visible="unreconciled,cleared,reconciled,void" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attachments" type="object" class="oe_stat_button" icon="fa-paperclip">
                            <field name="attachment_count" widget="statinfo" string="Receipts"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="transaction_date"/>
                            <field name="check_number"/>
                            <field name="account_id"/>
                            <field name="payee_id"/>
                            <field name="category_id" invisible="is_split" options="{'no_create': True}"/>
                            <field name="is_split"/>
                            <field name="reconciled_date" invisible="state != 'reconciled'"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="running_balance" widget="monetary" readonly="1"/>
                            <field name="memo"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="is_transfer"/>
                            <field name="transfer_account_id" invisible="not is_transfer"/>
                            <field name="linked_transaction_id" invisible="not is_transfer"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Receipt &amp; Document" name="receipt_page">
                            <group>
                                <field name="receipt_attachment" widget="image" class="oe_avatar" options="{'size': [250, 250]}"/>
                                <field name="receipt_filename" invisible="1"/>
                            </group>
                        </page>
                        <page string="Split Line Items" name="splits_page" invisible="not is_split">
                            <field name="split_ids">
                                <list editable="bottom">
                                    <field name="category_id" options="{'no_create': True}"/>
                                    <field name="memo"/>
                                    <field name="tag_ids" widget="many2many_tags"/>
                                    <field name="amount" widget="monetary" sum="Total Splits"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Quicken Checkbook Register List View (Odoo 18 uses list) -->
    <record id="view_moneta_transaction_tree" model="ir.ui.view">
        <field name="name">moneta.transaction.list</field>
        <field name="model">moneta.transaction</field>
        <field name="arch" type="xml">
            <list string="Transaction Register" editable="bottom" default_order="transaction_date desc, id desc" decoration-muted="state == 'void'">
                <field name="transaction_date" string="Date"/>
                <field name="check_number" string="Check #" optional="show"/>
                <field name="account_id" string="Account"/>
                <field name="payee_image" widget="image" string="" options="{'size': [20, 20]}" optional="show"/>
                <field name="payee_id" string="Payee"/>
                <field name="category_id" string="Category" options="{'no_create': True}"/>
                <field name="memo" string="Memo"/>
                <button name="action_toggle_cleared" type="object" string="Clr" 
                        title="Click to toggle: Unreconciled -> Cleared -> Reconciled"
                        icon="fa-check-circle"
                        invisible="state == 'void'"
                        class="btn-link"/>
                <field name="state" string="Status" widget="badge" 
                       decoration-info="state == 'cleared'" 
                       decoration-success="state == 'reconciled'" 
                       decoration-muted="state == 'void'"/>
                <field name="payment_amount" string="Payment" widget="monetary" optional="hide"/>
                <field name="deposit_amount" string="Deposit" widget="monetary" optional="hide"/>
                <field name="amount" string="Amount" widget="monetary" sum="Total Amount" decoration-danger="amount &lt; 0" decoration-success="amount &gt; 0"/>
                <field name="running_balance" string="Balance" widget="monetary" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_transfer" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Transaction Search View -->
    <record id="view_moneta_transaction_search" model="ir.ui.view">
        <field name="name">moneta.transaction.search</field>
        <field name="model">moneta.transaction</field>
        <field name="arch" type="xml">
            <search string="Search Transactions">
                <field name="payee_id"/>
                <field name="memo" string="Memo / Description"/>
                <field name="check_number" string="Check # / Ref"/>
                <field name="account_id"/>
                <field name="category_id"/>
                <field name="tag_ids"/>
                
                <filter name="filter_unreconciled" string="Unreconciled" domain="[('state', '=', 'unreconciled')]"/>
                <filter name="filter_cleared" string="Cleared" domain="[('state', '=', 'cleared')]"/>
                <filter name="filter_reconciled" string="Reconciled" domain="[('state', '=', 'reconciled')]"/>
                <separator/>
                <filter name="filter_payments" string="Payments &amp; Expenses" domain="[('amount', '&lt;', 0)]"/>
                <filter name="filter_deposits" string="Deposits &amp; Income" domain="[('amount', '&gt;', 0)]"/>
                <separator/>
                <filter name="filter_not_void" string="Exclude Void" domain="[('state', '!=', 'void')]"/>
                
                <group expand="0" string="Group By">
                    <filter name="group_by_account" string="Account" context="{'group_by': 'account_id'}"/>
                    <filter name="group_by_payee" string="Payee" context="{'group_by': 'payee_id'}"/>
                    <filter name="group_by_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_date" string="Month" context="{'group_by': 'transaction_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Transaction Pivot View -->
    <record id="view_moneta_transaction_pivot" model="ir.ui.view">
        <field name="name">moneta.transaction.pivot</field>
        <field name="model">moneta.transaction</field>
        <field name="arch" type="xml">
            <pivot string="Spending Analysis">
                <field name="category_id" type="row"/>
                <field name="transaction_date" type="col" interval="month"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Transaction Graph View -->
    <record id="view_moneta_transaction_graph" model="ir.ui.view">
        <field name="name">moneta.transaction.graph</field>
        <field name="model">moneta.transaction</field>
        <field name="arch" type="xml">
            <graph string="Monthly Income vs Expenses" type="bar">
                <field name="transaction_date" interval="month"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Transaction Action -->
    <record id="action_moneta_transaction" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">moneta.transaction</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_moneta_transaction_search"/>
        <field name="context">{'search_default_filter_not_void': 1}</field>
    </record>

    <!-- Reconciliation actions available from the list Action menu -->
    <record id="action_moneta_tx_mark_cleared" model="ir.actions.server">
        <field name="name">Mark Cleared</field>
        <field name="model_id" ref="model_moneta_transaction"/>
        <field name="state">code</field>
        <field name="code">records.action_mark_cleared()</field>
        <field name="binding_model_id" ref="model_moneta_transaction"/>
        <field name="binding_view_types">list</field>
    </record>
    <record id="action_moneta_tx_reconcile" model="ir.actions.server">
        <field name="name">Reconcile</field>
        <field name="model_id" ref="model_moneta_transaction"/>
        <field name="state">code</field>
        <field name="code">records.action_reconcile()</field>
        <field name="binding_model_id" ref="model_moneta_transaction"/>
        <field name="binding_view_types">list</field>
    </record>
    <record id="action_moneta_tx_unreconcile" model="ir.actions.server">
        <field name="name">Unreconcile</field>
        <field name="model_id" ref="model_moneta_transaction"/>
        <field name="state">code</field>
        <field name="code">records.action_unreconcile()</field>
        <field name="binding_model_id" ref="model_moneta_transaction"/>
        <field name="binding_view_types">list</field>
    </record>


    <!-- Batch Category Assignment Wizard View -->
    <record id="view_moneta_transaction_batch_category_form" model="ir.ui.view">
        <field name="name">moneta.transaction.batch.category.wizard.form</field>
        <field name="model">moneta.transaction.batch.category.wizard</field>
        <field name="arch" type="xml">
            <form string="Batch Categorize Transactions">
                <sheet>
                    <group>
                        <field name="category_id" options="{'no_create': True}"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                    </group>
                    <field name="transaction_ids" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_apply" string="Apply Category to Selected" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Batch Categorize Server Action in Action Dropdown -->
    <record id="action_moneta_tx_batch_category" model="ir.actions.server">
        <field name="name">Batch Assign Category &amp; Tags</field>
        <field name="model_id" ref="model_moneta_transaction"/>
        <field name="state">code</field>
        <field name="code">action = records.action_batch_set_category()</field>
        <field name="binding_model_id" ref="model_moneta_transaction"/>
        <field name="binding_view_types">list</field>
    </record>



</odoo>
