<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Account Form View -->
    <record id="view_moneta_account_form" model="ir.ui.view">
        <field name="name">moneta.account.form</field>
        <field name="model">moneta.account</field>
        <field name="arch" type="xml">
            <form string="Account">
                <header>
                    <button name="action_new_trade" type="object" string="➕ New Investment Trade" class="btn-primary" icon="fa-line-chart" invisible="account_type not in ('brokerage', 'retirement', 'crypto')"/>
                    <button name="action_reconcile_statement" type="object" string="Reconcile Statement" class="btn-primary" icon="fa-check-square-o" invisible="account_type in ('brokerage', 'retirement', 'crypto', 'loan', 'mortgage')"/>
                    <button name="action_import_file" type="object" string="Import CSV / QIF" class="btn-secondary" icon="fa-upload"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_holdings" type="object" class="oe_stat_button" icon="fa-pie-chart" invisible="account_type not in ('brokerage', 'retirement', 'crypto')">
                            <field name="total_portfolio_market_value" widget="statinfo" string="Stock Value"/>
                        </button>
                        <button name="action_view_trades" type="object" class="oe_stat_button" icon="fa-exchange" invisible="account_type not in ('brokerage', 'retirement', 'crypto')">
                            <field name="trade_count" widget="statinfo" string="Trades"/>
                        </button>
                        <button name="action_view_loan_scenario" type="object" class="oe_stat_button" icon="fa-calculator" invisible="account_type not in ('loan', 'mortgage', 'loc')">
                            <field name="loan_monthly_payment" widget="statinfo" string="Monthly P&amp;I"/>
                        </button>
                        <button name="action_view_transactions" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="current_balance" widget="statinfo" string="Cash Balance"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <span class="text-muted text-uppercase fw-bold small"><field name="account_type"/> Account</span>
                        <h1><field name="name" placeholder="e.g. Interactive Brokers Main, DBS Multi-Currency..."/></h1>
                    </div>

                    <!-- Brokerage & Investment Portfolio Hero Summary Card -->
                    <div class="card border-0 shadow-sm rounded-4 p-3 my-3" style="background: #f8faff; border-left: 4px solid #0d6efd !important;" invisible="account_type not in ('brokerage', 'retirement', 'crypto')">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold text-dark mb-0"><i class="fa fa-line-chart text-primary me-2"/>Investment Portfolio Summary</h6>
                            <span class="badge rounded-pill bg-primary px-3 py-1"><field name="holding_count"/> Securities Held</span>
                        </div>
                        <div class="row g-3 text-center">
                            <div class="col-6 col-md-3 border-end">
                                <span class="text-muted small">Uninvested Cash</span>
                                <h4 class="fw-bold mb-0 text-dark"><field name="current_balance" widget="monetary"/></h4>
                            </div>
                            <div class="col-6 col-md-3 border-end">
                                <span class="text-muted small">Stock Market Value</span>
                                <h4 class="fw-bold mb-0 text-primary"><field name="total_portfolio_market_value" widget="monetary"/></h4>
                            </div>
                            <div class="col-6 col-md-3 border-end">
                                <span class="text-muted small">Cost Basis</span>
                                <h4 class="fw-bold mb-0 text-dark"><field name="total_portfolio_cost_basis" widget="monetary"/></h4>
                            </div>
                            <div class="col-6 col-md-3">
                                <span class="text-muted small">Unrealized Gain / Loss</span>
                                <h4 class="fw-bold mb-0" decoration-success="total_portfolio_gain &gt; 0" decoration-danger="total_portfolio_gain &lt; 0">
                                    <field name="total_portfolio_gain" widget="monetary"/> (<field name="total_portfolio_gain_percent"/>%)
                                </h4>
                            </div>
                        </div>
                    </div>

                    <!-- Loan & Mortgage Amortization Hero Summary Card (v1.15.0) -->
                    <div class="card border-0 shadow-sm rounded-4 p-3 my-3" style="background: #fff9f5; border-left: 4px solid #fd7e14 !important;" invisible="account_type not in ('loan', 'mortgage', 'loc')">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold text-dark mb-0"><i class="fa fa-home text-warning me-2"/>Loan &amp; Mortgage Amortization Summary</h6>
                            <button name="action_view_loan_scenario" type="object" string="📊 View Amortization Scenario" class="btn btn-sm btn-outline-warning"/>
                        </div>
                        <div class="row g-3 text-center">
                            <div class="col-6 col-md-3 border-end">
                                <span class="text-muted small">Outstanding Debt</span>
                                <h4 class="fw-bold mb-0 text-danger"><field name="current_balance" widget="monetary"/></h4>
                            </div>
                            <div class="col-6 col-md-3 border-end">
                                <span class="text-muted small">Monthly Payment (P&amp;I)</span>
                                <h4 class="fw-bold mb-0 text-dark"><field name="loan_monthly_payment" widget="monetary"/></h4>
                            </div>
                            <div class="col-6 col-md-3 border-end">
                                <span class="text-muted small">Estimated Payoff Date</span>
                                <h4 class="fw-bold mb-0 text-dark"><field name="loan_payoff_date"/></h4>
                            </div>
                            <div class="col-6 col-md-3">
                                <span class="text-muted small">Remaining Total Interest</span>
                                <h4 class="fw-bold mb-0 text-warning"><field name="loan_remaining_interest" widget="monetary"/></h4>
                            </div>
                        </div>
                    </div>

                    <!-- Top Account Details Tabs -->
                    <notebook class="mt-3 mb-4">
                        <page string="Account Information" name="account_info_tab">
                            <group>
                                <group string="Account Profile">
                                    <field name="name"/>
                                    <field name="account_type"/>
                                    <field name="currency_id"/>
                                    <field name="account_number"/>
                                </group>
                                <group string="Banking &amp; Institution">
                                    <field name="institution_id"/>
                                    <field name="institution_name"/>
                                    <field name="billing_cycle_day" invisible="account_type != 'credit_card'"/>
                                    <field name="payment_due_day" invisible="account_type != 'credit_card'"/>
                                    <field name="next_statement_date" readonly="1" invisible="account_type != 'credit_card'"/>
                                    <field name="next_payment_due_date" readonly="1" invisible="account_type != 'credit_card'"/>
                                    <field name="current_cycle_spent" widget="monetary" readonly="1" invisible="account_type != 'credit_card'"/>
                                </group>
                            </group>
                        </page>

                        <page string="Balances &amp; Limits" name="balances_tab">
                            <group>
                                <group string="Current Balances">
                                    <field name="current_balance" widget="monetary" readonly="1" class="fw-bold fs-5 text-primary"/>
                                    <field name="cleared_balance" widget="monetary" readonly="1"/>
                                    <field name="opening_balance" widget="monetary"/>
                                    <field name="opening_balance_date"/>
                                    <field name="credit_limit" widget="monetary" invisible="account_type != 'credit_card'"/>
                                </group>
                                <group string="Forecast Milestones" invisible="account_type in ('brokerage', 'retirement', 'crypto', 'loan', 'mortgage')">
                                    <field name="forecast_balance_30d" widget="monetary"/>
                                    <field name="forecast_balance_60d" widget="monetary"/>
                                    <field name="forecast_balance_90d" widget="monetary"/>
                                </group>
                            </group>
                            <div class="card border-0 shadow-xs rounded-4 p-3 my-2 bg-white" invisible="account_type in ('brokerage', 'retirement', 'crypto', 'loan', 'mortgage')">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-dark mb-0">
                                        <i class="fa fa-line-chart text-primary me-2"/>90-Day Balance Trajectory (Forecast)
                                    </h6>
                                    <span class="badge rounded-pill bg-light text-primary border px-3 py-1 fw-bold" style="font-size: 0.72rem;">
                                        Scheduled Inflows &amp; Outflows
                                    </span>
                                </div>
                                <field name="forecast_chart_svg" widget="html" nolabel="1"/>
                            </div>
                        </page>

                        <page string="Terms &amp; Settings" name="terms_tab">
                            <group>
                                <group string="Financial Terms">
                                    <field name="interest_rate" invisible="account_type not in ('loan', 'mortgage', 'loc', 'savings')"/>
                                    <field name="fx_fee_percent" invisible="account_type not in ('checking', 'chequing','savings','credit_card','loc','cash')"/>
                                    <field name="sequence"/>
                                </group>
                                <group string="Preferences &amp; Status">
                                    <field name="is_favourite"/>
                                    <field name="exclude_from_net_worth"/>
                                    <field name="is_closed"/>
                                    <field name="closed_date" invisible="not is_closed"/>
                                </group>
                            </group>
                        </page>

                        <page string="📈 Portfolio Holdings" name="holdings_page" invisible="account_type not in ('brokerage', 'retirement', 'crypto')">
                            <field name="holding_ids">
                                <list default_order="market_value desc" create="true">
                                    <field name="symbol" string="Ticker"/>
                                    <field name="security_id" string="Security Name"/>
                                    <field name="asset_class" widget="badge"/>
                                    <field name="quantity" string="Shares" options="{'precision': 8}"/>
                                    <field name="average_cost" string="Avg Cost" widget="monetary"/>
                                    <field name="current_price" string="Current Quote" widget="monetary"/>
                                    <field name="cost_basis" string="Cost Basis" widget="monetary" sum="Total Cost Basis"/>
                                    <field name="market_value" string="Market Value" widget="monetary" sum="Total Market Value"/>
                                    <field name="unrealized_gain" string="Gain / Loss ($)" widget="monetary" sum="Total Gain/Loss" decoration-success="unrealized_gain &gt; 0" decoration-danger="unrealized_gain &lt; 0"/>
                                    <field name="unrealized_gain_percent" string="Gain (%)" decoration-success="unrealized_gain_percent &gt; 0" decoration-danger="unrealized_gain_percent &lt; 0"/>
                                    <field name="annual_dividend_income" string="Est. Dividends" widget="monetary" sum="Total Dividends" optional="show"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="🔄 Investment Trades" name="trades_page" invisible="account_type not in ('brokerage', 'retirement', 'crypto')">
                            <field name="investment_transaction_ids">
                                <list default_order="trade_date desc, id desc" create="true">
                                    <field name="trade_date" string="Trade Date"/>
                                    <field name="action" widget="badge" 
                                           decoration-success="action == 'buy'" 
                                           decoration-warning="action == 'sell'" 
                                           decoration-info="action == 'dividend'" 
                                           decoration-muted="action == 'split'"/>
                                    <field name="security_id" string="Security"/>
                                    <field name="quantity" string="Quantity" options="{'precision': 8}"/>
                                    <field name="price" string="Price" options="{'precision': 10}"/>
                                    <field name="commission" string="Fee" widget="monetary"/>
                                    <field name="total_amount" string="Net Amount" widget="monetary" sum="Total Amount"/>
                                    <field name="realized_gain" string="Realized Gain" widget="monetary" sum="Realized Gain"/>
                                    <field name="memo" string="Memo" optional="show"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Sharing &amp; Access" name="sharing_page">
                            <field name="share_ids">
                                <list editable="bottom">
                                    <field name="user_id"/>
                                    <field name="permission" widget="badge"/>
                                    <field name="is_joint"/>
                                    <field name="exclude_from_net_worth"/>
                                </list>
                            </field>
                        </page>

                        <page string="Notes" name="notes_page">
                            <field name="notes" placeholder="Account notes or remarks..."/>
                        </page>
                    </notebook>

                    <!-- Bottom Permanent Full-Width Transaction Register -->
                    <div class="mt-4 pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-dark mb-0">
                                <i class="fa fa-book text-primary me-2"/>Transaction Register
                            </h5>
                            <span class="badge bg-light text-dark border px-3 py-1 fw-semibold">
                                Point-in-Time Running Balance Ledger
                            </span>
                        </div>
                        <field name="transaction_ids">
                            <list editable="bottom" default_order="transaction_date desc, id desc" limit="100" decoration-muted="state == 'void'">
                                <field name="transaction_date" string="Date"/>
                                <field name="check_number" string="Check #" optional="show"/>
                                <field name="payee_id" string="Payee"/>
                                <field name="category_id" string="Category" options="{'no_create': True}"/>
                                <field name="memo" string="Memo"/>
                                <button name="action_toggle_cleared" type="object" string="Clr" 
                                        title="Click to toggle: Unreconciled -> Cleared -> Reconciled"
                                        icon="fa-check-circle"
                                        invisible="state == 'void'"
                                        class="btn-link"/>
                                <field name="state" string="Status" widget="badge" 
                                       decoration-info="state == 'cleared'" 
                                       decoration-success="state == 'reconciled'" 
                                       decoration-muted="state == 'void'"/>
                                <field name="amount" widget="monetary" sum="Total Amount" decoration-danger="amount &lt; 0" decoration-success="amount &gt; 0"/>
                                <field name="running_balance" string="Balance" widget="monetary" optional="show"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Premier Account Kanban View with Uniform Height & Symmetric Color-Coded Design -->
    <record id="view_moneta_account_kanban" model="ir.ui.view">
        <field name="name">moneta.account.kanban</field>
        <field name="model">moneta.account</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" default_order="sequence, is_favourite desc, name" records_draggable="1" sample="1">
                <field name="sequence"/>
                <field name="name"/>
                <field name="account_type"/>
                <field name="account_group"/>
                <field name="currency_id"/>
                <field name="institution_name"/>
                <field name="current_balance"/>
                <field name="cleared_balance"/>
                <field name="total_portfolio_market_value"/>
                <field name="total_portfolio_gain"/>
                <field name="total_portfolio_gain_percent"/>
                <field name="holding_count"/>
                <field name="trade_count"/>
                <field name="is_favourite"/>
                <field name="credit_limit"/>
                <templates>
                    <t t-name="card">
                        <t t-set="is_cc" t-value="['credit_card', 'loc'].includes(record.account_type.raw_value)"/>
                        <t t-set="is_loan" t-value="['mortgage', 'loan'].includes(record.account_type.raw_value)"/>
                        <t t-set="is_cash" t-value="['checking', 'chequing', 'savings', 'cash'].includes(record.account_type.raw_value)"/>
                        <t t-set="is_inv" t-value="['brokerage', 'retirement', 'crypto'].includes(record.account_type.raw_value)"/>
                        
                        <t t-set="card_border" t-value="is_cc ? '#8E44AD' : (is_loan ? '#E74C3C' : (is_cash ? '#2ECC71' : '#3498DB'))"/>
                        <t t-set="card_bg" t-value="is_cc ? 'linear-gradient(180deg, #F4ECF7 0%, #FFFFFF 100%)' : (is_loan ? 'linear-gradient(180deg, #FDEDEC 0%, #FFFFFF 100%)' : (is_cash ? 'linear-gradient(180deg, #EAFAF1 0%, #FFFFFF 100%)' : 'linear-gradient(180deg, #EBF5FB 0%, #FFFFFF 100%)'))"/>
                        <t t-set="badge_class" t-value="is_cc ? 'text-white' : (is_loan ? 'bg-danger text-white' : (is_cash ? 'bg-success text-white' : 'bg-primary text-white'))"/>
                        <t t-set="badge_style" t-value="is_cc ? 'background-color: #8E44AD !important;' : ''"/>
                        <t t-set="icon_name" t-value="record.account_type.raw_value == 'mortgage' ? 'fa-home' : (record.account_type.raw_value == 'loan' ? 'fa-car' : (record.account_type.raw_value in ['credit_card', 'loc'] ? 'fa-credit-card' : (record.account_type.raw_value in ['brokerage', 'retirement', 'crypto'] ? 'fa-line-chart' : (record.account_type.raw_value == 'savings' ? 'fa-money' : 'fa-bank'))))"/>

                        <div class="oe_kanban_global_click o_kanban_card rounded-4 shadow-sm p-3 mb-3 d-flex flex-column justify-content-between" 
                             t-att-style="'border: 2px solid ' + card_border + ' !important; background: ' + card_bg + ' !important; height: 185px; min-height: 185px; max-height: 185px; box-sizing: border-box;'">
                            
                            <!-- 1. Header (Fixed Height: 44px) -->
                            <div class="d-flex justify-content-between align-items-start" style="height: 44px; overflow: hidden;">
                                <div class="d-flex align-items-center me-2 text-truncate">
                                    <field name="sequence" widget="handle" class="me-2 text-muted" style="cursor: grab; font-size: 0.9rem;" title="Drag to reorder"/>
                                    <div t-attf-class="rounded-circle p-2 me-2 d-flex align-items-center justify-content-center flex-shrink-0 #{badge_class} shadow-xs" 
                                         t-att-style="badge_style + ' width: 34px; height: 34px;'">
                                        <i t-attf-class="fa #{icon_name}"/>
                                    </div>
                                    <div class="text-truncate">
                                        <strong class="fs-6 text-dark fw-bold d-block text-truncate" t-att-title="record.name.value"><field name="name"/></strong>
                                        <div class="text-muted small text-truncate" style="font-size: 0.78rem;">
                                            <i class="fa fa-university me-1" t-if="record.institution_name.value"/><field name="institution_name"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                    <span t-attf-class="badge rounded-pill text-uppercase px-2 py-1 #{badge_class}" t-att-style="badge_style + ' font-size: 0.68rem;'">
                                        <field name="account_type"/>
                                    </span>
                                    <field name="is_favourite" widget="boolean_favorite" nolabel="1"/>
                                </div>
                            </div>

                            <!-- 2. Financial Value Hero (Fixed Height: 65px) -->
                            <div class="px-3 py-2 rounded-3 bg-white bg-opacity-80 shadow-xs border d-flex flex-column justify-content-center" 
                                 style="height: 65px; box-sizing: border-box;">
                                <!-- Brokerage & Investments (BLUE) -->
                                <t t-if="is_inv">
                                    <div class="d-flex justify-content-between align-items-baseline">
                                        <span class="text-muted small fw-semibold" style="font-size: 0.78rem;">Portfolio Value:</span>
                                        <h4 class="mb-0 fw-bold text-primary fs-5"><field name="total_portfolio_market_value" widget="monetary"/></h4>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-1 text-muted" style="font-size: 0.75rem;">
                                        <span>Cash: <strong class="text-dark"><field name="current_balance" widget="monetary"/></strong></span>
                                        <span t-if="record.total_portfolio_gain.raw_value" 
                                              t-attf-class="fw-bold {{ record.total_portfolio_gain.raw_value &gt;= 0 ? 'text-success' : 'text-danger' }}">
                                            <t t-if="record.total_portfolio_gain.raw_value &gt; 0">+</t><field name="total_portfolio_gain_percent"/>%
                                        </span>
                                    </div>
                                </t>
                                <!-- Credit Cards (PURPLE) -->
                                <t t-elif="is_cc">
                                    <div class="d-flex justify-content-between align-items-baseline">
                                        <span class="text-muted small fw-semibold" style="font-size: 0.78rem;">Card Balance:</span>
                                        <h4 class="mb-0 fw-bold fs-5" style="color: #8E44AD !important;"><field name="current_balance" widget="monetary"/></h4>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-1 text-muted" style="font-size: 0.75rem;">
                                        <span>Limit: <strong class="text-dark"><field name="credit_limit" widget="monetary"/></strong></span>
                                        <span class="badge rounded-pill bg-light text-dark border">Statement Cycle</span>
                                    </div>
                                </t>
                                <!-- Mortgages & Loans (RED) -->
                                <t t-elif="is_loan">
                                    <div class="d-flex justify-content-between align-items-baseline">
                                        <span class="text-muted small fw-semibold" style="font-size: 0.78rem;">Principal Debt:</span>
                                        <h4 class="mb-0 fw-bold text-danger fs-5"><field name="current_balance" widget="monetary"/></h4>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-1 text-muted" style="font-size: 0.75rem;">
                                        <span t-if="record.loan_monthly_payment.raw_value">P&amp;I: <strong class="text-dark"><field name="loan_monthly_payment" widget="monetary"/></strong></span>
                                        <span t-else="" class="badge bg-danger-subtle text-danger fw-semibold">Active Loan</span>
                                        <span t-if="record.loan_payoff_date.raw_value" class="badge rounded-pill bg-light text-dark border">Payoff: <field name="loan_payoff_date"/></span>
                                    </div>
                                </t>
                                <!-- Cash & Bank Accounts (GREEN) -->
                                <t t-else="">
                                    <div class="d-flex justify-content-between align-items-baseline">
                                        <span class="text-muted small fw-semibold" style="font-size: 0.78rem;">Available Cash:</span>
                                        <h4 class="mb-0 fw-bold text-success fs-5"><field name="current_balance" widget="monetary"/></h4>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-1 text-muted" style="font-size: 0.75rem;">
                                        <span>Cleared: <strong class="text-dark"><field name="cleared_balance" widget="monetary"/></strong></span>
                                        <span class="badge bg-success-subtle text-success fw-semibold">Active Bank</span>
                                    </div>
                                </t>
                            </div>

                            <!-- 3. Bottom Action Row (Fixed Height: 30px) -->
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top" style="height: 30px;">
                                <t t-if="is_inv">
                                    <button name="action_view_holdings" type="object" class="btn btn-sm btn-outline-primary py-0 px-2 fw-semibold" style="font-size: 0.78rem;">
                                        <i class="fa fa-pie-chart me-1"/>Holdings (<field name="holding_count"/>)
                                    </button>
                                    <button name="action_view_transactions" type="object" class="btn btn-sm btn-link text-decoration-none py-0 px-1 text-muted" style="font-size: 0.78rem;">
                                        <i class="fa fa-list me-1"/>Register
                                    </button>
                                </t>
                                <t t-elif="is_cc">
                                    <button name="action_view_transactions" type="object" class="btn btn-sm btn-outline-secondary py-0 px-2 fw-semibold" style="border-color: #8E44AD; color: #8E44AD; font-size: 0.78rem;">
                                        <i class="fa fa-credit-card me-1"/>Transactions
                                    </button>
                                    <span class="text-muted" style="font-size: 0.75rem;"><field name="next_payment_due_date" widget="date"/></span>
                                </t>
                                <t t-elif="is_loan">
                                    <button name="action_view_transactions" type="object" class="btn btn-sm btn-outline-secondary py-0 px-2 fw-semibold" style="font-size: 0.78rem;">
                                        <i class="fa fa-list me-1"/>Transactions
                                    </button>
                                    <button name="action_view_loan_scenario" type="object" class="btn btn-sm btn-link text-decoration-none py-0 px-1 text-warning fw-semibold" style="font-size: 0.78rem;">
                                        <i class="fa fa-calculator me-1"/>Amortization
                                    </button>
                                </t>
                                <t t-else="">
                                    <button name="action_view_transactions" type="object" class="btn btn-sm btn-outline-secondary py-0 px-2 fw-semibold" style="font-size: 0.78rem;">
                                        <i class="fa fa-list me-1"/>Transactions
                                    </button>
                                    <button name="action_reconcile_statement" type="object" class="btn btn-sm btn-link text-decoration-none py-0 px-1 text-primary fw-semibold" style="font-size: 0.78rem;" t-if="is_cash">
                                        <i class="fa fa-check-square-o me-1"/>Reconcile
                                    </button>
                                </t>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Account List View -->
    <record id="view_moneta_account_tree" model="ir.ui.view">
        <field name="name">moneta.account.list</field>
        <field name="model">moneta.account</field>
        <field name="arch" type="xml">
            <list string="Accounts" 
                  decoration-danger="account_type in ('loan', 'mortgage')" 
                  decoration-success="account_type in ('checking', 'chequing', 'savings', 'cash')"
                  decoration-info="account_type in ('credit_card', 'loc')"
                  decoration-primary="account_type in ('brokerage', 'retirement', 'crypto')">
                <field name="sequence" widget="handle"/>
                <field name="is_favourite" widget="boolean_toggle"/>
                <field name="name"/>
                <field name="institution_name"/>
                <field name="account_type" widget="badge" 
                       decoration-danger="account_type in ('loan', 'mortgage')" 
                       decoration-success="account_type in ('checking', 'chequing', 'savings', 'cash')"
                       decoration-info="account_type in ('credit_card', 'loc')"
                       decoration-primary="account_type in ('brokerage', 'retirement', 'crypto')"/>
                <field name="currency_id"/>
                <field name="current_balance" string="Cash Balance" widget="monetary" sum="Total Cash Balance"
                       decoration-danger="account_type in ('loan', 'mortgage') or current_balance &lt; 0"
                       decoration-success="account_type in ('checking', 'chequing', 'savings', 'cash') and current_balance &gt;= 0"
                       decoration-info="account_type in ('credit_card', 'loc')"/>
                <field name="total_portfolio_market_value" string="Stock Value" widget="monetary" sum="Total Stock Value" optional="show"/>
                <field name="cleared_balance" widget="monetary" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Account Search View -->
    <record id="view_moneta_account_search" model="ir.ui.view">
        <field name="name">moneta.account.search</field>
        <field name="model">moneta.account</field>
        <field name="arch" type="xml">
            <search string="Search Accounts">
                <field name="name"/>
                <field name="institution_name"/>
                <field name="account_type"/>
                <filter name="filter_favourites" string="Favourites" domain="[('is_favourite', '=', True)]"/>
                <filter name="filter_brokerage" string="Brokerage &amp; Investments" domain="[('account_type', 'in', ('brokerage', 'retirement', 'crypto'))]"/>
                <filter name="filter_open" string="Active (Not Closed)" domain="[('is_closed', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_account_group" string="Balance Sheet Category" context="{'group_by': 'account_group'}"/>
                    <filter name="group_by_type" string="Account Type" context="{'group_by': 'account_type'}"/>
                    <filter name="group_by_institution" string="Institution" context="{'group_by': 'institution_name'}"/>
                    <filter name="group_by_currency" string="Currency" context="{'group_by': 'currency_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_moneta_account" model="ir.actions.act_window">
        <field name="name">Accounts</field>
        <field name="res_model">moneta.account</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_moneta_account_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
    </record>
</odoo>
