<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Form View -->
    <record id="view_moneta_security_form" model="ir.ui.view">
        <field name="name">moneta.security.form</field>
        <field name="model">moneta.security</field>
        <field name="arch" type="xml">
            <form string="Security / Asset">
                <header>
                    <button name="action_fetch_quote" type="object" string="🔍 Auto-Fetch Live Info &amp; Quote" class="btn btn-primary" icon="fa-cloud-download"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="text-muted text-uppercase fw-bold small"><field name="asset_class"/> · <field name="exchange"/></span>
                        <div class="d-flex align-items-center gap-3">
                            <h1 class="mb-0 flex-grow-1">
                                <field name="symbol" placeholder="Ticker (e.g. AAPL, VOO, NVDA, D05.SI)..."/>
                            </h1>
                            <button name="action_fetch_quote" type="object" string="🔍 Auto-Fetch Info &amp; Quote (Yahoo)" class="btn btn-primary" icon="fa-cloud-download"/>
                        </div>
                        <h2>
                            <field name="name" placeholder="Full Company / Asset Name..."/>
                        </h2>
                    </div>

                    <!-- Security Live Quote Metric Card -->
                    <div class="card border-0 shadow-sm rounded-4 p-3 my-3" style="background: #f8faff; border-left: 4px solid #198754 !important;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small fw-bold text-uppercase">
                                <i class="fa fa-line-chart text-success me-1"/>Market Quote &amp; Valuation (Yahoo Finance)
                            </span>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge rounded-pill bg-light text-dark border">
                                    <i class="fa fa-clock-o me-1"/>As of: <field name="quote_timestamp"/>
                                </span>
                                <button name="action_fetch_quote" type="object" string="🔄 Refresh Quote" class="btn btn-sm btn-outline-success"/>
                            </div>
                        </div>
                        <div class="row g-3 align-items-center">
                            <div class="col-12 col-md-4">
                                <span class="text-muted small">Latest Closing / Market Price</span>
                                <h2 class="fw-bolder mb-0 text-dark">
                                    <field name="current_price" widget="monetary"/>
                                </h2>
                            </div>
                            <div class="col-6 col-md-4 border-start">
                                <span class="text-muted small">Annual Dividend / Share</span>
                                <h5 class="fw-bold mb-0 text-dark"><field name="annual_dividend_rate" widget="monetary"/></h5>
                                <span class="text-muted small">Yield: <field name="dividend_yield_pct"/>% (<field name="dividend_frequency"/>)</span>
                            </div>
                            <div class="col-6 col-md-4 border-start">
                                <span class="text-muted small">Target Allocation Weight</span>
                                <h5 class="fw-bold mb-0 text-primary"><field name="total_allocation_weight"/>%</h5>
                                <span class="text-muted small">Currency: <field name="currency_id"/></span>
                            </div>
                        </div>
                    </div>

                    <group>
                        <group name="general_info" string="General Information">
                            <field name="asset_class"/>
                            <field name="exchange"/>
                            <field name="currency_id"/>
                            <field name="isin"/>
                            <field name="is_benchmark" widget="boolean_toggle"/>
                        </group>
                        <group name="dividend_info" string="Dividend, Distribution &amp; Tax Profile">
                            <field name="annual_dividend_rate" widget="monetary"/>
                            <field name="dividend_yield_pct" widget="percentage"/>
                            <field name="dividend_frequency"/>
                            <field name="dividend_tax_treatment"/>
                            <field name="is_sreit" widget="boolean_toggle"/>
                            <field name="is_sgx_security" invisible="1"/>
                            <field name="is_ucits_etf" invisible="1"/>
                            <field name="next_ex_dividend_date"/>
                            <field name="next_pay_date"/>
                        </group>
                        <group name="valuation_metrics" string="Valuation &amp; Market Fundamentals (MS Money)">
                            <field name="day_change" widget="monetary" decoration-success="day_change &gt; 0" decoration-danger="day_change &lt; 0"/>
                            <field name="day_change_percent" decoration-success="day_change_percent &gt; 0" decoration-danger="day_change_percent &lt; 0"/>
                            <field name="fifty_two_week_high" widget="monetary"/>
                            <field name="fifty_two_week_low" widget="monetary"/>
                            <field name="day_volume"/>
                            <field name="market_cap" widget="monetary"/>
                            <field name="pe_ratio"/>
                            <field name="forward_pe"/>
                            <field name="eps" widget="monetary"/>
                            <field name="beta"/>
                        </group>
                    </group>
                    <group name="links" string="Links &amp; Online References">
                        <group>
                            <field name="website_url" widget="url" placeholder="https://..."/>
                        </group>
                        <group>
                            <field name="ir_url" widget="url" placeholder="https://investor..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="📊 Price History" name="price_history">
                            <field name="price_ids">
                                <list editable="bottom" default_order="price_date desc">
                                    <field name="price_date" string="Date"/>
                                    <field name="price_close" string="Closing Price" widget="monetary"/>
                                    <field name="source" string="Data Source" widget="badge"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="🌍 Asset Allocations" name="asset_allocations">
                            <field name="allocation_ids">
                                <list editable="bottom">
                                    <field name="asset_class"/>
                                    <field name="weight" widget="float" digits="[5, 2]"/>
                                    <field name="country_code" placeholder="US"/>
                                </list>
                            </field>
                        </page>
                        <page string="📁 Documents &amp; Factsheets" name="documents">
                            <field name="document_ids" widget="many2many_binary"/>
                        </page>
                        <page string="📝 Notes" name="notes">
                            <field name="notes" placeholder="Investment thesis, strategy rationale, target buy price..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Security List View -->
    <record id="view_moneta_security_tree" model="ir.ui.view">
        <field name="name">moneta.security.list</field>
        <field name="model">moneta.security</field>
        <field name="arch" type="xml">
            <list string="Securities" default_order="symbol asc">
                <header>
                    <button name="action_fetch_all_quotes" type="object" string="🔄 Refresh All Live Quotes (Yahoo Finance)" class="btn btn-primary"/>
                </header>
                <field name="symbol" string="Ticker" class="fw-bold"/>
                <field name="name" string="Company / ETF Name"/>
                <field name="asset_class" widget="badge"/>
                <field name="exchange" string="Exchange"/>
                <field name="currency_id"/>
                <field name="current_price" string="Latest Quote" widget="monetary"/>
                <field name="dividend_yield_pct" string="Div Yield (%)" widget="percentage" optional="show"/>
                <field name="annual_dividend_rate" string="Div / Share" widget="monetary" optional="hide"/>
                <field name="quote_timestamp" string="Last Updated" optional="show"/>
                <button name="action_fetch_quote" type="object" string="🔄 Update" class="btn-sm btn-outline-primary" title="Fetch live quote &amp; fundamentals from Yahoo Finance"/>
            </list>
        </field>
    </record>

    <!-- Investment Transaction Form View (Premier Redesign) -->
    <record id="view_moneta_investment_transaction_form" model="ir.ui.view">
        <field name="name">moneta.investment.transaction.form</field>
        <field name="model">moneta.investment.transaction</field>
        <field name="arch" type="xml">
            <form string="Investment Trade">
                <sheet>
                    <div class="oe_title">
                        <span class="text-muted text-uppercase fw-bold small">Trade Execution Entry</span>
                        <div class="d-flex align-items-center gap-3 my-1">
                            <field name="action" widget="radio" options="{'horizontal': true}"/>
                        </div>
                    </div>

                    <!-- Trade Value Hero Banner -->
                    <div class="card border-0 shadow-sm rounded-4 p-4 my-3" style="background: linear-gradient(135deg, #f8faff 0%, #eef3fc 100%); border-left: 5px solid #0d6efd !important;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small fw-bold text-uppercase tracking-wider">
                                <i class="fa fa-money text-primary me-1"/>Total Settlement Outlay / Proceeds
                            </span>
                            <span class="badge rounded-pill bg-success-subtle text-success px-3 py-1 fw-bold fs-6" invisible="action != 'buy'">🟢 BUY TRADE</span>
                            <span class="badge rounded-pill bg-warning-subtle text-warning px-3 py-1 fw-bold fs-6" invisible="action != 'sell'">🟠 SELL TRADE</span>
                            <span class="badge rounded-pill bg-info-subtle text-info px-3 py-1 fw-bold fs-6" invisible="action != 'dividend'">🟣 DIVIDEND</span>
                            <span class="badge rounded-pill bg-secondary px-3 py-1 fw-bold fs-6" invisible="action != 'split'">STOCK SPLIT</span>
                        </div>
                        <div class="row g-3 align-items-center">
                            <div class="col-12 col-md-5">
                                <h1 class="fw-bolder mb-0 text-dark">
                                    <field name="total_amount" widget="monetary" readonly="1"/>
                                </h1>
                                <span class="text-muted small">Auto-debited/credited in linked brokerage cash account</span>
                            </div>
                            <div class="col-6 col-md-3 border-start">
                                <span class="text-muted small">Execution Unit Price</span>
                                <h4 class="fw-bold mb-0 text-dark"><field name="price" widget="monetary"/></h4>
                            </div>
                            <div class="col-6 col-md-4 border-start">
                                <span class="text-muted small">Shares / Units</span>
                                <h4 class="fw-bold mb-0 text-primary"><field name="quantity"/> Shares</h4>
                            </div>
                        </div>
                    </div>

                    <group>
                        <group name="trade_header" string="Trade Details">
                            <field name="action"/>
                            <field name="security_id" options="{'no_quick_create': False}"/>
                            <field name="account_id" options="{'no_create': False}"/>
                            <field name="trade_date"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group name="trade_pricing" string="Pricing &amp; Settlement">
                            <field name="quantity" widget="float" options="{'precision': 8}"/>
                            <field name="price" widget="monetary"
                                   help="Leave empty when the cost is unknown -- an unknown cost never reads as 0."/>
                            <field name="commission" widget="monetary"/>
                            <field name="total_amount" widget="monetary" readonly="1"/>
                            <field name="realized_gain" widget="monetary" readonly="1" invisible="action != 'sell'"/>
                        </group>
                        <group name="tax_lot_group" string="Tax-Lot Matching &amp; Capital Gains" invisible="action != 'sell'">
                            <field name="lot_disposal_strategy"/>
                            <field name="specific_lot_id" invisible="lot_disposal_strategy != 'specific_id'"/>
                            <field name="short_term_realized_gain" widget="monetary" readonly="1" decoration-danger="short_term_realized_gain &lt; 0" decoration-success="short_term_realized_gain &gt; 0"/>
                            <field name="long_term_realized_gain" widget="monetary" readonly="1" decoration-danger="long_term_realized_gain &lt; 0" decoration-success="long_term_realized_gain &gt; 0"/>
                        </group>
                        <group name="notes_group" string="Memo &amp; Accounting">
                            <field name="memo" placeholder="Trade rationale, limit order notes, dividend distribution info..."/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'cleared'"
                                   decoration-success="state == 'reconciled'"
                                   decoration-muted="state == 'void'"/>
                            <field name="reconciled_date" invisible="state != 'reconciled'"/>
                            <field name="linked_transaction_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook invisible="action != 'sell'">
                        <page string="Tax-Lot Disposals" name="tax_lot_disposal_page">
                            <field name="lot_disposal_ids" readonly="1">
                                <list>
                                    <field name="lot_id" string="Acquired Lot"/>
                                    <field name="disposal_date"/>
                                    <field name="quantity_sold" string="Shares Sold"/>
                                    <field name="cost_basis_sold" widget="monetary"/>
                                    <field name="proceeds" widget="monetary"/>
                                    <field name="realized_gain" widget="monetary" decoration-success="realized_gain &gt; 0" decoration-danger="realized_gain &lt; 0"/>
                                    <field name="term_type" widget="badge" decoration-info="term_type == 'short_term'" decoration-success="term_type == 'long_term'"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Investment Transaction List View (Premier Redesign) -->
    <record id="view_moneta_investment_transaction_tree" model="ir.ui.view">
        <field name="name">moneta.investment.transaction.list</field>
        <field name="model">moneta.investment.transaction</field>
        <field name="arch" type="xml">
            <list string="Investment Trades" default_order="trade_date desc, id desc" decoration-muted="state == 'void'">
                <field name="trade_date" string="Trade Date" class="fw-semibold"/>
                <field name="action" string="Action" widget="badge" 
                       decoration-success="action == 'buy'" 
                       decoration-warning="action == 'sell'" 
                       decoration-info="action == 'dividend'" 
                       decoration-muted="action == 'split'"/>
                <field name="security_id" string="Security / Ticker" class="fw-bold"/>
                <field name="account_id" string="Brokerage Account"/>
                <button name="action_toggle_cleared" type="object" string="Clr" 
                        title="Click to toggle: Unreconciled -> Cleared -> Reconciled"
                        icon="fa-check-circle"
                        invisible="state == 'void'"
                        class="btn-link"/>
                <field name="state" string="Status" widget="badge" 
                       decoration-info="state == 'cleared'" 
                       decoration-success="state == 'reconciled'" 
                       decoration-muted="state == 'void'"/>
                <field name="quantity" string="Shares / Units" options="{'precision': 8}"/>
                <field name="price" string="Execution Price" widget="monetary"/>
                <field name="commission" string="Broker Fee" widget="monetary" optional="show"/>
                <field name="total_amount" string="Net Amount ($)" widget="monetary" sum="Total Amount" class="fw-bold"/>
                <field name="realized_gain" string="Realized Gain ($)" widget="monetary" sum="Realized Gain" optional="show"
                       decoration-success="realized_gain &gt; 0" decoration-danger="realized_gain &lt; 0"/>
                <field name="memo" string="Memo" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Investment Transaction Search View -->
    <record id="view_moneta_investment_transaction_search" model="ir.ui.view">
        <field name="name">moneta.investment.transaction.search</field>
        <field name="model">moneta.investment.transaction</field>
        <field name="arch" type="xml">
            <search string="Search Trades">
                <field name="security_id"/>
                <field name="account_id"/>
                <field name="memo"/>
                <filter name="filter_buys" string="🟢 Buy Orders" domain="[('action', '=', 'buy')]"/>
                <filter name="filter_sells" string="🟠 Sell Orders" domain="[('action', '=', 'sell')]"/>
                <filter name="filter_dividends" string="🟣 Dividends" domain="[('action', '=', 'dividend')]"/>
                <separator/>
                <filter name="filter_unreconciled" string="Unreconciled" domain="[('state', '=', 'unreconciled')]"/>
                <filter name="filter_cleared" string="Cleared" domain="[('state', '=', 'cleared')]"/>
                <filter name="filter_reconciled" string="Reconciled" domain="[('state', '=', 'reconciled')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_security" string="Security / Ticker" context="{'group_by': 'security_id'}"/>
                    <filter name="group_by_account" string="Brokerage Account" context="{'group_by': 'account_id'}"/>
                    <filter name="group_by_action" string="Action Type" context="{'group_by': 'action'}"/>
                    <filter name="group_by_status" string="Reconciliation Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_date" string="Trade Month" context="{'group_by': 'trade_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Holding Form View -->
    <record id="view_moneta_holding_form" model="ir.ui.view">
        <field name="name">moneta.holding.form</field>
        <field name="model">moneta.holding</field>
        <field name="arch" type="xml">
            <form string="Portfolio Holding">
                <header>
                    <button name="action_fetch_quote" type="object" string="🔄 Refresh Quote (Yahoo Finance)" class="btn btn-primary" icon="fa-cloud-download"/>
                    <button name="action_refresh_all_quotes" type="object" string="🔄 Refresh All Portfolio Quotes" class="btn btn-outline-secondary" icon="fa-refresh"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="text-muted text-uppercase fw-bold small"><field name="asset_class"/> · <field name="account_id"/></span>
                        <h1>
                            <field name="security_id" readonly="1"/>
                        </h1>
                    </div>

                    <!-- Holding Live Performance Card -->
                    <div class="card border-0 shadow-sm rounded-4 p-4 my-3" style="background: linear-gradient(135deg, #ffffff 0%, #f8faff 100%); border-left: 5px solid #0d6efd !important;">
                        <div class="row g-3 align-items-center text-center">
                            <div class="col-6 col-md-3 border-end">
                                <span class="text-muted small">Total Market Value</span>
                                <h3 class="fw-bolder mb-0 text-primary"><field name="market_value" widget="monetary" readonly="1"/></h3>
                            </div>
                            <div class="col-6 col-md-3 border-end">
                                <span class="text-muted small">Total Cost Basis</span>
                                <h4 class="fw-bold mb-0 text-dark"><field name="cost_basis" widget="monetary" readonly="1"/></h4>
                            </div>
                            <div class="col-6 col-md-3 border-end">
                                <span class="text-muted small">Unrealized Gain / Loss</span>
                                <h4 class="fw-bold mb-0" decoration-success="unrealized_gain &gt; 0" decoration-danger="unrealized_gain &lt; 0">
                                    <field name="unrealized_gain" widget="monetary" readonly="1"/> (<field name="unrealized_gain_percent"/>%)
                                </h4>
                            </div>
                            <div class="col-6 col-md-3">
                                <span class="text-muted small">Est. Annual Dividends</span>
                                <h4 class="fw-bold mb-0 text-success"><field name="annual_dividend_income" widget="monetary" readonly="1"/></h4>
                            </div>
                        </div>
                    </div>

                    <group>
                        <group string="Holding Units &amp; Cost">
                            <field name="quantity" readonly="1" options="{'precision': 8}"/>
                            <field name="average_cost" widget="monetary" readonly="1"/>
                            <field name="cost_basis" widget="monetary" readonly="1"/>
                            <field name="account_id" readonly="1"/>
                        </group>
                        <group string="Market Valuation &amp; Returns">
                            <field name="current_price" widget="monetary" readonly="1"/>
                            <field name="market_value" widget="monetary" readonly="1"/>
                            <field name="unrealized_gain" widget="monetary" readonly="1"/>
                            <field name="unrealized_gain_percent" readonly="1"/>
                            <field name="dividend_yield" widget="percentage" readonly="1"/>
                            <field name="twr_percent" widget="percentage" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Premier Portfolio Holding List View -->
    <record id="view_moneta_holding_tree" model="ir.ui.view">
        <field name="name">moneta.holding.list</field>
        <field name="model">moneta.holding</field>
        <field name="arch" type="xml">
            <list string="Portfolio Holdings" default_order="market_value desc">
                <header>
                    <button name="action_refresh_all_quotes" type="object" string="🔄 Refresh All Live Quotes (Yahoo Finance)" class="btn btn-primary"/>
                </header>
                <field name="symbol" string="Ticker" class="fw-bold"/>
                <field name="security_id" string="Security Name"/>
                <field name="account_id" string="Account"/>
                <field name="asset_class" widget="badge"/>
                <field name="quantity" string="Shares" options="{'precision': 8}"/>
                <field name="average_cost" string="Avg Cost" widget="monetary"/>
                <field name="current_price" string="Quote" widget="monetary"/>
                <field name="cost_basis" string="Cost Basis" widget="monetary" sum="Total Basis"/>
                <field name="market_value" string="Market Value" widget="monetary" sum="Total Market Value" class="fw-bold"/>
                <field name="unrealized_gain" string="Gain / Loss ($)" widget="monetary" sum="Total Gain/Loss" decoration-success="unrealized_gain &gt; 0" decoration-danger="unrealized_gain &lt; 0"/>
                <field name="unrealized_gain_percent" string="Gain (%)" decoration-success="unrealized_gain_percent &gt; 0" decoration-danger="unrealized_gain_percent &lt; 0"/>
                <field name="day_gain_loss" string="Day Gain ($)" widget="monetary" sum="Total Day Gain" decoration-success="day_gain_loss &gt; 0" decoration-danger="day_gain_loss &lt; 0" optional="show"/>
                <field name="day_gain_loss_percent" string="Day Gain (%)" decoration-success="day_gain_loss_percent &gt; 0" decoration-danger="day_gain_loss_percent &lt; 0" optional="show"/>
                <field name="percent_of_portfolio" string="% Portfolio" widget="percentage" optional="show"/>
                <field name="annual_dividend_income" string="Est. Dividends" widget="monetary" sum="Total Dividends" optional="show"/>
                <field name="dividend_yield" string="Yield (%)" widget="percentage" optional="show"/>
                <field name="twr_percent" string="TWR (%)" widget="percentage" optional="show"/>
                <field name="fifty_two_week_high" string="52W High" widget="monetary" optional="hide"/>
                <field name="fifty_two_week_low" string="52W Low" widget="monetary" optional="hide"/>
                <field name="pe_ratio" string="P/E" optional="hide"/>
                <field name="market_cap" string="Market Cap" widget="monetary" optional="hide"/>
                <field name="beta" string="Beta" optional="hide"/>
                <field name="price_known" widget="boolean" optional="hide"/>
                <field name="basis_known" widget="boolean" optional="hide"/>
                <button name="action_fetch_quote" type="object" string="🔄 Quote" class="btn-sm btn-outline-primary" title="Fetch live quote from Yahoo Finance"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Holding Search View -->
    <record id="view_moneta_holding_search" model="ir.ui.view">
        <field name="name">moneta.holding.search</field>
        <field name="model">moneta.holding</field>
        <field name="arch" type="xml">
            <search string="Search Holdings">
                <field name="symbol"/>
                <field name="security_id"/>
                <field name="account_id"/>
                <field name="asset_class"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_account" string="Account" context="{'group_by': 'account_id'}"/>
                    <filter name="group_by_asset_class" string="Asset Class" context="{'group_by': 'asset_class'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Holding Graph View (Asset Allocation) -->
    <record id="view_moneta_holding_graph" model="ir.ui.view">
        <field name="name">moneta.holding.graph</field>
        <field name="model">moneta.holding</field>
        <field name="arch" type="xml">
            <graph string="Portfolio Asset Allocation" type="pie">
                <field name="asset_class"/>
                <field name="market_value" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_moneta_investment_transaction" model="ir.actions.act_window">
        <field name="name">Investment Trades</field>
        <field name="res_model">moneta.investment.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_moneta_investment_transaction_search"/>
    </record>

    <record id="action_moneta_security" model="ir.actions.act_window">
        <field name="name">Securities &amp; Prices</field>
        <field name="res_model">moneta.security</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_moneta_holding" model="ir.actions.act_window">
        <field name="name">Portfolio Holdings</field>
        <field name="res_model">moneta.holding</field>
        <field name="view_mode">list,form,graph</field>
        <field name="search_view_id" ref="view_moneta_holding_search"/>
