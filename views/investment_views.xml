<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Form View -->
    <record id="view_moneta_security_form" model="ir.ui.view">
        <field name="name">moneta.security.form</field>
        <field name="model">moneta.security</field>
        <field name="arch" type="xml">
            <form string="Security / Asset">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="symbol" placeholder="Ticker (e.g. AAPL)..."/>
                        </h1>
                        <h2>
                            <field name="name" placeholder="Full Name..."/>
                        </h2>
                    </div>
                    <group>
                        <group name="general_info" string="General Information">
                            <field name="asset_class"/>
                            <field name="exchange"/>
                            <field name="currency_id"/>
                            <field name="isin"/>
                        </group>
                        <group name="market_info" string="Market &amp; Quote">
                            <field name="current_price" widget="monetary"/>
                            <field name="quote_timestamp"/>
                            <field name="is_market_open" widget="boolean"/>
                            <field name="total_allocation_weight" widget="percentage" readonly="1"/>
                        </group>
                    </group>
                    <group name="dividend_info" string="Dividend &amp; Benchmark Profile (Wealthfolio Style)">
                        <group>
                            <field name="annual_dividend_rate" widget="monetary"/>
                            <field name="dividend_yield_pct" widget="percentage"/>
                            <field name="dividend_frequency"/>
                        </group>
                        <group>
                            <field name="next_ex_dividend_date"/>
                            <field name="next_pay_date"/>
                            <field name="is_benchmark" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group name="links" string="Links &amp; Reference">
                        <group>
                            <field name="website_url" widget="url" placeholder="https://..."/>
                        </group>
                        <group>
                            <field name="ir_url" widget="url" placeholder="https://investor..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Price History" name="price_history">
                            <field name="price_ids">
                                <list editable="bottom">
                                    <field name="price_date"/>
                                    <field name="price_close" widget="monetary"/>
                                    <field name="source"/>
                                </list>
                            </field>
                        </page>
                        <page string="Asset Allocations" name="asset_allocations">
                            <field name="allocation_ids">
                                <list editable="bottom">
                                    <field name="asset_class"/>
                                    <field name="weight" widget="float" digits="[5, 2]"/>
                                    <field name="country_code" placeholder="US"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documents &amp; Factsheets" name="documents">
                            <field name="document_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Investment notes, strategy rationale..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Security List View (Odoo 18 uses list) -->
    <record id="view_moneta_security_tree" model="ir.ui.view">
        <field name="name">moneta.security.list</field>
        <field name="model">moneta.security</field>
        <field name="arch" type="xml">
            <list string="Securities">
                <field name="symbol"/>
                <field name="name"/>
                <field name="asset_class" widget="badge"/>
                <field name="currency_id"/>
                <field name="current_price" widget="monetary"/>
            </list>
        </field>
    </record>

    <!-- Investment Transaction Form View -->
    <record id="view_moneta_investment_transaction_form" model="ir.ui.view">
        <field name="name">moneta.investment.transaction.form</field>
        <field name="model">moneta.investment.transaction</field>
        <field name="arch" type="xml">
            <form string="Investment Transaction">
                <sheet>
                    <group>
                        <group>
                            <field name="action"/>
                            <field name="security_id"/>
                            <field name="account_id"/>
                            <field name="trade_date"/>
                        </group>
                        <group>
                            <field name="quantity" widget="float" options="{'precision': 8}"/>
                            <field name="price" widget="float" options="{'precision': 10}"
                                   help="Leave empty when the cost is unknown -- an unknown cost never reads as 0."/>
                            <field name="commission" widget="monetary"/>
                            <field name="total_amount" widget="monetary" readonly="1"/>
                            <field name="realized_gain" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="memo"/>
                        <field name="linked_transaction_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Investment Transaction List View -->
    <record id="view_moneta_investment_transaction_tree" model="ir.ui.view">
        <field name="name">moneta.investment.transaction.list</field>
        <field name="model">moneta.investment.transaction</field>
        <field name="arch" type="xml">
            <list string="Investment Transactions">
                <field name="trade_date"/>
                <field name="action" widget="badge"/>
                <field name="security_id"/>
                <field name="account_id"/>
                <field name="quantity" options="{'precision': 8}"/>
                <field name="price" options="{'precision': 10}"/>
                <field name="commission" widget="monetary"/>
                <field name="total_amount" widget="monetary" sum="Total Amount"/>
                <field name="realized_gain" widget="monetary" sum="Realized Gain"/>
            </list>
        </field>
    </record>

    <!-- Holding Form View -->
    <record id="view_moneta_holding_form" model="ir.ui.view">
        <field name="name">moneta.holding.form</field>
        <field name="model">moneta.holding</field>
        <field name="arch" type="xml">
            <form string="Portfolio Holding">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="security_id" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="account_id" readonly="1"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="quantity" readonly="1" options="{'precision': 8}"/>
                            <field name="average_cost" widget="monetary" readonly="1"/>
                            <field name="cost_basis" widget="monetary" readonly="1"/>
                        </group>
                        <group>
                            <field name="current_price" widget="monetary" readonly="1"/>
                            <field name="market_value" widget="monetary" readonly="1"/>
                            <field name="unrealized_gain" widget="monetary" readonly="1"/>
                            <field name="unrealized_gain_percent" readonly="1"/>
                            <field name="annual_dividend_income" widget="monetary" readonly="1"/>
                            <field name="dividend_yield" widget="percentage" readonly="1"/>
                            <field name="twr_percent" widget="percentage" readonly="1"/>
                            <field name="mwr_percent" widget="percentage" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Premier Portfolio Holding List View -->
    <record id="view_moneta_holding_tree" model="ir.ui.view">
        <field name="name">moneta.holding.list</field>
        <field name="model">moneta.holding</field>
        <field name="arch" type="xml">
            <list string="Portfolio Holdings">
                <field name="symbol" string="Symbol"/>
                <field name="security_id" string="Security Name"/>
                <field name="account_id" string="Account"/>
                <field name="asset_class" widget="badge"/>
                <field name="quantity" string="Shares" options="{'precision': 8}"/>
                <field name="average_cost" string="Avg Cost" widget="monetary"/>
                <field name="current_price" string="Quote" widget="monetary"/>
                <field name="cost_basis" string="Cost Basis" widget="monetary" sum="Total Basis"/>
                <field name="market_value" string="Market Value" widget="monetary" sum="Total Market Value"/>
                <field name="unrealized_gain" string="Gain / Loss ($)" widget="monetary" sum="Total Gain/Loss" decoration-success="unrealized_gain &gt; 0" decoration-danger="unrealized_gain &lt; 0"/>
                <field name="unrealized_gain_percent" string="Gain (%)" decoration-success="unrealized_gain_percent &gt; 0" decoration-danger="unrealized_gain_percent &lt; 0"/>
                <field name="annual_dividend_income" string="Est. Dividends" widget="monetary" sum="Total Dividends" optional="show"/>
                <field name="dividend_yield" string="Yield (%)" widget="percentage" optional="show"/>
                <field name="twr_percent" string="TWR (%)" widget="percentage" optional="show"/>
                <field name="price_known" widget="boolean" optional="hide"/>
                <field name="basis_known" widget="boolean" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Holding Search View -->
    <record id="view_moneta_holding_search" model="ir.ui.view">
        <field name="name">moneta.holding.search</field>
        <field name="model">moneta.holding</field>
        <field name="arch" type="xml">
            <search string="Search Holdings">
                <field name="symbol"/>
                <field name="security_id"/>
                <field name="account_id"/>
                <field name="asset_class"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_account" string="Account" context="{'group_by': 'account_id'}"/>
                    <filter name="group_by_asset_class" string="Asset Class" context="{'group_by': 'asset_class'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Holding Graph View (Asset Allocation) -->
    <record id="view_moneta_holding_graph" model="ir.ui.view">
        <field name="name">moneta.holding.graph</field>
        <field name="model">moneta.holding</field>
        <field name="arch" type="xml">
            <graph string="Portfolio Asset Allocation" type="pie">
                <field name="asset_class"/>
                <field name="market_value" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_moneta_investment_transaction" model="ir.actions.act_window">
        <field name="name">Investment Transactions</field>
        <field name="res_model">moneta.investment.transaction</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_moneta_security" model="ir.actions.act_window">
        <field name="name">Securities &amp; Tickers</field>
        <field name="res_model">moneta.security</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_moneta_holding" model="ir.actions.act_window">
        <field name="name">Portfolio Holdings</field>
        <field name="res_model">moneta.holding</field>
        <field name="view_mode">list,form,graph</field>
        <field name="search_view_id" ref="view_moneta_holding_search"/>
    </record>
</odoo>
