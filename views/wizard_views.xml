<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Import Wizard View -->
    <record id="view_moneta_import_wizard_form" model="ir.ui.view">
        <field name="name">moneta.import.wizard.form</field>
        <field name="model">moneta.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Financial File (QIF / OFX / CSV)">
                <sheet>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="bank_profile" invisible="file_type != 'csv'"/>
                            <field name="file_type"/>
                        </group>
                        <group>
                            <field name="file_data" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                    </group>
                    <group string="CSV Column Mapping" invisible="file_type != 'csv'">
                        <group>
                            <field name="csv_has_header"/>
                            <field name="csv_date_col"/>
                            <field name="csv_payee_col"/>
                            <field name="csv_amount_col"/>
                            <field name="csv_debit_col"/>
                            <field name="csv_credit_col"/>
                            <field name="csv_category_col"/>
                            <field name="csv_memo_col"/>
                        </group>
                        <group>
                            <field name="csv_column_count"/>
                            <field name="csv_preview" nolabel="1" colspan="2"/>
                        </group>
                    </group>
                    <group string="Import Options">
                        <group>
                            <field name="skip_duplicates" widget="boolean_toggle"/>
                            <field name="apply_rules" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="imported_count" invisible="imported_count == 0" readonly="1"/>
                            <field name="skipped_count" invisible="skipped_count == 0" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save_preset_to_institution" string="💾 Save Mapping for Bank"
                            type="object" invisible="file_type != 'csv'" class="btn-outline-secondary"
                            help="Save the modified column mappings permanently for this financial institution."/>
                    <button name="action_import" string="🚀 Import Transactions" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Import Wizard Action -->
    <record id="action_moneta_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Financial Data</field>
        <field name="res_model">moneta.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Premier Bank Statement Reconciliation Wizard View -->
    <record id="view_moneta_reconciliation_wizard_form" model="ir.ui.view">
        <field name="name">moneta.reconciliation.wizard.form</field>
        <field name="model">moneta.reconciliation.wizard</field>
        <field name="arch" type="xml">
            <form string="Bank Statement Reconciliation">
                <sheet>
                    <group>
                        <group string="Statement Summary">
                            <field name="account_id" readonly="1"/>
                            <field name="statement_date"/>
                            <field name="statement_ending_balance" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Cleared Balance vs. Difference">
                            <field name="cleared_payments_total" widget="monetary" readonly="1"/>
                            <field name="cleared_deposits_total" widget="monetary" readonly="1"/>
                            <field name="cleared_balance" widget="monetary" readonly="1" class="fw-bold"/>
                            <field name="difference" widget="monetary" readonly="1" 
                                   decoration-success="difference == 0" 
                                   decoration-danger="difference != 0" 
                                   class="fw-bold fs-4"/>
                        </group>
                    </group>
                    <div class="mb-2">
                        <button name="action_select_all" string="Select All" type="object" class="btn-secondary btn-sm me-2"/>
                        <button name="action_unselect_all" string="Unselect All" type="object" class="btn-secondary btn-sm"/>
                    </div>
                    <notebook>
                        <page string="Transactions to Match" name="lines_page">
                            <field name="line_ids">
                                <list editable="bottom" default_order="transaction_date asc">
                                    <field name="is_cleared" string="Clr" widget="boolean"/>
                                    <field name="transaction_date" string="Date" readonly="1"/>
                                    <field name="check_number" string="Check #" readonly="1"/>
                                    <field name="payee_id" string="Payee" readonly="1"/>
                                    <field name="memo" string="Memo" readonly="1"/>
                                    <field name="amount" string="Amount" widget="monetary" readonly="1" decoration-danger="amount &lt; 0" decoration-success="amount &gt; 0"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_reconcile_finish" string="Finish &amp; Reconcile" type="object" class="btn-primary" icon="fa-check"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Reconciliation Action -->
    <record id="action_moneta_reconciliation_wizard" model="ir.actions.act_window">
        <field name="name">Reconcile Account Statement</field>
        <field name="res_model">moneta.reconciliation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <!-- Payee Smart Deduplication & Merge Wizard View -->
    <record id="view_moneta_payee_merge_wizard_form" model="ir.ui.view">
        <field name="name">moneta.payee.merge.wizard.form</field>
        <field name="model">moneta.payee.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Merge Duplicate Payees">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle me-2"/>
                        Select a primary canonical payee and the duplicate payee names to merge. All historical transactions and recurring bill schedules will be safely moved to the primary payee, and duplicate names will be registered as search aliases.
                    </div>
                    <group>
                        <field name="primary_payee_id" options="{'no_create': True}"/>
                        <field name="create_aliases" widget="boolean_toggle"/>
                    </group>
                    <group string="Duplicate Payees to Absorb">
                        <field name="duplicate_payee_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_merge" string="Merge Payees" type="object" class="btn-primary" icon="fa-compress"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_moneta_payee_merge_wizard" model="ir.actions.act_window">
        <field name="name">Merge Duplicate Payees</field>
        <field name="res_model">moneta.payee.merge.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Account Checkbook Register Export Wizard View -->
    <record id="view_moneta_export_wizard_form" model="ir.ui.view">
        <field name="name">moneta.export.wizard.form</field>
        <field name="model">moneta.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Checkbook Register (QIF / CSV)">
                <sheet>
                    <field name="state" invisible="1"/>
                    <div invisible="state != 'choose'">
                        <group string="Export Scope &amp; Format">
                            <field name="account_ids" widget="many2many_tags"/>
                            <field name="export_format" widget="radio"/>
                        </group>
                        <group string="Date Filter (Optional)">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </div>
                    <div invisible="state != 'get'" class="text-center py-4">
                        <h4 class="fw-bold text-success mb-3"><i class="fa fa-check-circle me-2"/>Export Ready for Download</h4>
                        <field name="file_data" filename="file_name" widget="binary"/>
                        <p class="text-muted small mt-2">Click above to save your backup file (<field name="file_name" readonly="1"/>).</p>
                    </div>
                </sheet>
                <footer>
                    <button name="action_export" string="Generate Export File" type="object" class="btn-primary" invisible="state != 'choose'" icon="fa-download"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_moneta_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Checkbook Register</field>
        <field name="res_model">moneta.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
