<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quicken Premier & Sure Wealth Management Command Center -->
    <record id="view_moneta_dashboard_form" model="ir.ui.view">
        <field name="name">moneta.dashboard.form</field>
        <field name="model">moneta.dashboard</field>
        <field name="arch" type="xml">
            <form string="Personal Finance Command Center" class="o_moneta_dashboard">
                <sheet>


                    <!-- Sure-Style Insights Alert Banner -->
                    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4" style="background: linear-gradient(135deg, #f8faff 0%, #eef2ff 100%); border-left: 5px solid #4f46e5 !important;">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-white p-3 shadow-sm text-primary">
                                    <i class="fa fa-lightbulb-o fa-2x text-primary"/>
                                </div>
                                <div>
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="badge rounded-pill bg-primary px-3 py-1 text-white fw-bold">Smart Insight</span>
                                        <h5 class="fw-bold mb-0 text-dark"><field name="top_insight_title"/></h5>
                                        <span class="badge bg-white text-primary border fw-semibold"><field name="top_insight_badge"/></span>
                                    </div>
                                    <p class="text-muted small mb-0 mt-1"><field name="top_insight_desc"/></p>
                                </div>
                            </div>
                            <div>
                                <button name="action_open_insights" type="object" class="btn btn-primary rounded-pill px-4 shadow-sm">
                                    <i class="fa fa-arrow-circle-right me-1"/> View All Insights (<field name="insight_count"/>)
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Row 1: Primary Wealth & Cash Flow KPIs -->
                    <div class="row g-3 mb-3">
                        <!-- Net Worth Card -->
                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="card h-100 p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-muted fw-bold small text-uppercase">Net Worth</span>
                                    <span class="badge bg-success-light">
                                        <i class="fa fa-diamond fa-lg"/>
                                    </span>
                                </div>
                                <h3 class="fw-bold text-success mb-2">
                                    <field name="net_worth" widget="monetary"/>
                                </h3>
                                <div class="d-flex justify-content-between small text-muted pt-2 border-top">
                                    <span>Assets: <field name="total_assets" widget="monetary"/></span>
                                    <span>Debt: <field name="total_liabilities" widget="monetary"/></span>
                                </div>
                            </div>
                        </div>

                        <!-- Cash Flow Card -->
                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="card h-100 p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-muted fw-bold small text-uppercase">Cash Flow (<field name="month_label"/>)</span>
                                    <span class="badge bg-success" invisible="savings_rate &lt;= 0">
                                        <field name="savings_rate"/>% Saved
                                    </span>
                                    <span class="badge bg-info-light" invisible="savings_rate &gt; 0">
                                        <i class="fa fa-exchange fa-lg"/>
                                    </span>
                                </div>
                                <h3 class="fw-bold text-primary mb-2">
                                    <field name="month_net_savings" widget="monetary"/>
                                </h3>
                                <div class="d-flex justify-content-between small pt-2 border-top">
                                    <span class="text-success" title="Total Monthly Inflow"><i class="fa fa-arrow-up me-1"/><field name="month_income" widget="monetary"/></span>
                                    <span class="text-danger" title="Total Monthly Outflow"><i class="fa fa-arrow-down me-1"/><field name="month_expenses" widget="monetary"/></span>
                                </div>
                            </div>
                        </div>

                        <!-- Portfolio Card -->
                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="card h-100 p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-muted fw-bold small text-uppercase">Investment Portfolio</span>
                                    <span class="badge bg-warning-light">
                                        <i class="fa fa-line-chart fa-lg"/>
                                    </span>
                                </div>
                                <h3 class="fw-bold text-dark mb-2">
                                    <field name="portfolio_market_value" widget="monetary"/>
                                </h3>
                                <div class="d-flex justify-content-between small pt-2 border-top">
                                    <span>Gain: <field name="portfolio_unrealized_gain" widget="monetary" decoration-success="portfolio_unrealized_gain &gt;= 0" decoration-danger="portfolio_unrealized_gain &lt; 0"/></span>
                                    <span class="badge bg-success" invisible="portfolio_gain_percent &lt; 0">+<field name="portfolio_gain_percent"/>%</span>
                                    <span class="badge bg-danger" invisible="portfolio_gain_percent &gt;= 0"><field name="portfolio_gain_percent"/>%</span>
                                </div>
                            </div>
                        </div>

                        <!-- Real Estate Equity Card -->
                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="card h-100 p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-muted fw-bold small text-uppercase">Real Estate Equity</span>
                                    <span class="badge bg-primary-light">
                                        <i class="fa fa-home fa-lg"/>
                                    </span>
                                </div>
                                <h3 class="fw-bold text-dark mb-2">
                                    <field name="total_real_estate_equity" widget="monetary"/>
                                </h3>
                                <div class="d-flex justify-content-between small text-muted pt-2 border-top">
                                    <span>Valuation: <field name="real_estate_assets" widget="monetary"/></span>
                                    <span class="text-success fw-bold">Active Equity</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: Sure Balance Sheet Assets & Liabilities Breakdown -->
                    <div class="row g-3 mb-3">
                        <!-- Assets Breakdown -->
                        <div class="col-12 col-md-6">
                            <div class="card h-100 p-3">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h6 class="fw-bold text-dark mb-0">
                                        <i class="fa fa-pie-chart text-success me-2"/>Asset Allocation Breakdown
                                    </h6>
                                    <span class="badge bg-success-light">
                                        Total: <field name="total_assets" widget="monetary"/>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <span class="text-muted">🏦 Cash &amp; Bank Accounts</span>
                                    <span class="fw-bold text-dark"><field name="cash_assets" widget="monetary"/></span>
                                </div>
                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <span class="text-muted">📈 Stocks &amp; Brokerage</span>
                                    <span class="fw-bold text-dark"><field name="investment_assets" widget="monetary"/></span>
                                </div>
                                <div class="d-flex justify-content-between py-2">
                                    <span class="text-muted">🏡 Real Estate &amp; Properties</span>
                                    <span class="fw-bold text-dark"><field name="real_estate_assets" widget="monetary"/></span>
                                </div>
                            </div>
                        </div>

                        <!-- Liabilities Breakdown -->
                        <div class="col-12 col-md-6">
                            <div class="card h-100 p-3">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h6 class="fw-bold text-dark mb-0">
                                        <i class="fa fa-credit-card text-danger me-2"/>Debt &amp; Liabilities Breakdown
                                    </h6>
                                    <span class="badge bg-danger-light">
                                        Total: <field name="total_liabilities" widget="monetary"/>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <span class="text-muted">💳 Credit Card Balances</span>
                                    <span class="fw-bold text-danger"><field name="credit_card_debt" widget="monetary"/></span>
                                </div>
                                <div class="d-flex justify-content-between py-2 border-bottom">
                                    <span class="text-muted">🏛️ Mortgages &amp; Term Loans</span>
                                    <span class="fw-bold text-danger"><field name="loans_mortgages_debt" widget="monetary"/></span>
                                </div>
                                <div class="d-flex justify-content-between py-2">
                                    <span class="text-muted">📅 Upcoming Bills (14d)</span>
                                    <span class="fw-bold text-primary"><field name="upcoming_bills_total" widget="monetary"/> (<field name="upcoming_bill_count"/> due)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 3: Financial Freedom & Resilience (FIRE & Runway) -->
                    <div class="row g-3 mb-4">
                        <!-- Emergency Runway Card -->
                        <div class="col-12 col-md-6">
                            <div class="card h-100 p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-muted fw-bold small text-uppercase"><i class="fa fa-shield me-1 text-success"/>Financial Runway</span>
                                    <span class="badge bg-success"><field name="emergency_runway_months"/> Months</span>
                                </div>
                                <p class="text-muted small mb-0">
                                    Based on liquid cash assets vs. 3-month average burn rate. You can sustain your current lifestyle for <strong><field name="emergency_runway_months"/> months</strong> with zero active income.
                                </p>
                            </div>
                        </div>

                        <!-- FIRE Milestone Card -->
                        <div class="col-12 col-md-6">
                            <div class="card h-100 p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-muted fw-bold small text-uppercase"><i class="fa fa-fire me-1 text-danger"/>FIRE Goal (4% Rule)</span>
                                    <span class="fw-bold text-primary"><field name="fire_progress_pct"/>% Achieved</span>
                                </div>
                                <div class="my-2">
                                    <field name="fire_progress_pct" widget="progressbar"/>
                                </div>
                                <div class="d-flex justify-content-between small text-muted">
                                    <span>Target: <field name="fire_target_amount" widget="monetary"/></span>
                                    <span>(25× Annual Expenses)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Dynamic Quick Action Launchpad (Customizable) -->
                    <div class="card p-3 mb-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="fw-bold text-muted text-uppercase small mb-0">
                                <i class="fa fa-bolt me-1 text-warning"/>Quick Action Launchpad
                            </h6>
                            <button name="action_customize_launchpad" type="object" class="btn btn-sm btn-outline-secondary rounded-pill px-3" string="⚙️ Customize Buttons" icon="fa-cog"/>
                        </div>
                        <field name="action_launchpad_ids" mode="kanban" class="border-0 p-0 m-0" nolabel="1">
                            <kanban class="moneta-launchpad-kanban border-0 p-0 m-0" create="false">
                                <field name="name"/>
                                <field name="icon"/>
                                <field name="color_class"/>
                                <field name="action_type"/>
                                <templates>
                                    <t t-name="card">
                                        <button name="action_execute" type="object" 
                                                t-attf-class="btn moneta-launchpad-btn #{record.color_class.raw_value == 'primary' ? 'btn-primary text-white' : (record.color_class.raw_value == 'outline_success' ? 'btn-outline-success' : (record.color_class.raw_value == 'outline_danger' ? 'btn-outline-danger' : (record.color_class.raw_value == 'outline_warning' ? 'btn-outline-warning' : (record.color_class.raw_value == 'outline_info' ? 'btn-outline-info' : (record.color_class.raw_value == 'outline_dark' ? 'btn-outline-dark' : (record.color_class.raw_value == 'outline_secondary' ? 'btn-outline-secondary' : 'btn-outline-primary'))))))}">
                                            <i t-attf-class="fa #{record.icon.raw_value or 'fa-bolt'} fa-fw"/>
                                            <span class="fw-medium"><field name="name"/></span>
                                        </button>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </div>

                    <!-- Hidden technical fields -->
                    <field name="currency_id" invisible="1"/>
                    <field name="user_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_moneta_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">moneta.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
