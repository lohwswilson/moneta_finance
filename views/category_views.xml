<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Category Form View with Transactions, Total Amount, and Subcategories -->
    <record id="view_moneta_category_form" model="ir.ui.view">
        <field name="name">moneta.category.form</field>
        <field name="model">moneta.category</field>
        <field name="arch" type="xml">
            <form string="Transaction Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transactions" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="transaction_count" widget="statinfo" string="Transactions"/>
                        </button>
                        <button name="action_view_transactions" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="total_amount" widget="statinfo" string="Total Amount"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="parent_id" domain="[('id', '!=', id), ('user_id', '=', user_id)]"/>
                            <field name="category_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="is_income" invisible="1"/>
                            <field name="is_system" readonly="1"/>
                        </group>
                        <group>
                            <field name="icon"/>
                            <field name="color" widget="color"/>
                            <field name="user_id" groups="moneta_finance.group_moneta_manager"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Transactions" name="transactions_page">
                            <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                                <span class="text-muted fw-bold"><i class="fa fa-history me-1"/>Category Transactions Ledger</span>
                                <div class="d-flex align-items-center">
                                    <span class="text-muted me-2 fw-semibold">Total Amount:</span>
                                    <h5 class="mb-0 fw-bold">
                                        <field name="total_amount" widget="monetary" readonly="1" 
                                               decoration-danger="category_type == 'expense'" 
                                               decoration-success="category_type == 'income'"/>
                                    </h5>
                                </div>
                            </div>
                            <field name="transaction_ids" readonly="1">
                                <list string="Transactions" default_order="transaction_date desc, id desc">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="transaction_date"/>
                                    <field name="account_id"/>
                                    <field name="payee_id"/>
                                    <field name="memo"/>
                                    <field name="amount" widget="monetary" sum="Total Amount"
                                           decoration-danger="amount &lt; 0"
                                           decoration-success="amount &gt; 0"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Subcategories" name="subcategories_page" invisible="not child_ids">
                            <field name="child_ids" readonly="1">
                                <list string="Subcategories">
                                    <field name="icon" string=" " width="30px"/>
                                    <field name="name"/>
                                    <field name="category_type" widget="badge"/>
                                    <field name="transaction_count" string="Transactions"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes_page">
                            <field name="description" placeholder="Category notes or budgeting guidelines..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Category Search View -->
    <record id="view_moneta_category_search" model="ir.ui.view">
        <field name="name">moneta.category.search</field>
        <field name="model">moneta.category</field>
        <field name="arch" type="xml">
            <search string="Search Categories">
                <field name="display_name" string="Category"
                       filter_domain="['|', '|', '|', ('display_name', 'ilike', self), ('name', 'ilike', self), ('parent_id.name', 'ilike', self), ('transfer_account_id.name', 'ilike', self)]"/>
                <field name="name" string="Name"/>
                <field name="parent_id" string="Parent Category"/>
                <field name="transfer_account_id" string="Transfer Account"/>
                <field name="user_id" groups="moneta_finance.group_moneta_manager"/>
                <field name="parent_id"/>
                
                <filter name="my_categories" string="My Categories" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_expense" string="Expenses" domain="[('category_type', '=', 'expense')]"/>
                <filter name="filter_income" string="Income" domain="[('category_type', '=', 'income')]"/>
                <filter name="filter_transfer" string="Transfers" domain="[('category_type', '=', 'transfer')]"/>
                <separator/>
                <filter name="filter_user_only" string="Exclude System Templates" domain="[('is_system', '=', False)]"/>
                <filter name="filter_system_only" string="System Templates Only" domain="[('is_system', '=', True)]"/>
                
                <group expand="0" string="Group By">
                    <filter name="group_by_parent" string="Parent Category" context="{'group_by': 'parent_id'}"/>
                    <filter name="group_by_type" string="Category Type" context="{'group_by': 'category_type'}"/>
                    <filter name="group_by_owner" string="Owner" context="{'group_by': 'user_id'}" groups="moneta_finance.group_moneta_manager"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Category List View (Odoo 18 uses list tag) -->
    <record id="view_moneta_category_tree" model="ir.ui.view">
        <field name="name">moneta.category.list</field>
        <field name="model">moneta.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="icon" string=" " width="30px"/>
                <field name="display_name" string="Category Name"/>
                <field name="category_type" string="Type" widget="badge" decoration-success="category_type == 'income'" decoration-danger="category_type == 'expense'" decoration-info="category_type == 'transfer'"/>
                <field name="transaction_count" string="Transactions"/>
                <field name="total_amount" string="Total Volume" widget="monetary" optional="show"/>
                <field name="is_income" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="user_id" optional="show" groups="moneta_finance.group_moneta_manager"/>
                <field name="is_system" widget="boolean" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Category Action -->
    <record id="action_moneta_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">moneta.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_moneta_category_search"/>
        <field name="context">{'search_default_my_categories': 1, 'default_user_id': uid}</field>
    </record>

    <!-- One-time per-user seeding, reachable from the category list Action menu.
         The res.users hook + post_init_hook seed automatically; this is the manual
         fallback. -->
    <record id="action_seed_default_categories" model="ir.actions.server">
        <field name="name">Create Default Categories</field>
        <field name="model_id" ref="model_moneta_category"/>
        <field name="state">code</field>
        <field name="code">model._seed_user_defaults(env.user)</field>
        <field name="binding_model_id" ref="model_moneta_category"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
